<!doctype html>
<html>

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Users — 3Folks Media</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/public/styles.css?v=45" />
  <style>
    .input-container {
      display: flex;
      background: white;
      border-radius: 1rem;
      background: linear-gradient(135deg, #23272F 0%, #14161a 100%);
      box-shadow: 10px 10px 20px #0e1013, -10px -10px 40px #383e4b;
      padding: 0.3rem;
      gap: 0.3rem;
    }

    .input-container input {
      border-radius: 0.8rem 0 0 0.8rem;
      background: #23272F;
      box-shadow: inset 5px 5px 10px #0e1013, inset -5px -5px 10px #383e4b, 0px 0px 100px rgba(255, 212, 59, 0), 0px 0px 100px rgba(255, 102, 0, 0);
      width: 100%;
      flex-basis: 75%;
      padding: 1rem;
      border: none;
      border: 1px solid transparent;
      color: white;
      transition: all 0.2s ease-in-out;
      font-family: inherit;
      font-size: 14px;
    }

    .input-container input:focus {
      border: 1px solid #FFD43B;
      outline: none;
      box-shadow: inset 0px 0px 10px rgba(255, 102, 0, 0.5), inset 0px 0px 10px rgba(255, 212, 59, 0.5), 0px 0px 100px rgba(255, 212, 59, 0.5), 0px 0px 100px rgba(255, 102, 0, 0.5);
    }

    .input-container button {
      flex-basis: 25%;
      padding: 1rem;
      background: linear-gradient(135deg, rgb(255, 212, 59) 0%, rgb(255, 102, 0) 100%);
      box-shadow: 0px 0px 1px rgba(255, 212, 59, 0.5), 0px 0px 1px rgba(255, 102, 0, 0.5);
      font-weight: 900;
      letter-spacing: 0.3rem;
      text-transform: uppercase;
      color: #23272F;
      border: none;
      width: 100%;
      border-radius: 0 1rem 1rem 0;
      transition: all 0.2s ease-in-out;
      cursor: pointer;
      font-family: inherit;
    }

    .input-container button:hover {
      background: linear-gradient(135deg, rgb(255, 212, 59) 50%, rgb(255, 102, 0) 100%);
      box-shadow: 0px 0px 100px rgba(255, 212, 59, 0.5), 0px 0px 100px rgba(255, 102, 0, 0.5);
    }

    @media (max-width: 500px) {
      .input-container {
        flex-direction: column;
      }

      .input-container input {
        border-radius: 0.8rem;
      }

      .input-container button {
        padding: 1rem;
        border-radius: 0.8rem;
      }
    }

    /* Role Filter Bar Styles */
    .user-filters-bar {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 20px;
      align-items: center;
      padding: 12px;
      background: rgba(255, 255, 255, 0.03);
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .user-filter-label {
      font-size: 12px;
      font-weight: 700;
      color: #9CA3AF;
      margin-right: 6px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .user-filter-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 10px;
      background: #1e222a;
      border: 1px solid #323846;
      color: #d1d5db;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease-in-out;
      font-family: inherit;
    }

    .user-filter-btn:hover {
      background: #2a2f3a;
      border-color: #4b5563;
      color: #ffffff;
      transform: translateY(-1px);
    }

    .user-filter-btn.active {
      background: linear-gradient(135deg, #FFD43B 0%, #FF6600 100%);
      color: #14161a;
      border-color: transparent;
      font-weight: 800;
      box-shadow: 0 4px 14px rgba(255, 102, 0, 0.35);
    }

    .filter-count-badge {
      background: rgba(255, 255, 255, 0.15);
      padding: 2px 7px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }

    .user-filter-btn.active .filter-count-badge {
      background: rgba(0, 0, 0, 0.2);
      color: #14161a;
    }

    .admin-page .role-head {
      background: rgba(245, 158, 11, 0.12);
      color: #d97706;
      border: 1px solid rgba(245, 158, 11, 0.25);
    }
    .admin-page .role-hr {
      background: rgba(236, 72, 153, 0.12);
      color: #ec4899;
      border: 1px solid rgba(236, 72, 153, 0.25);
    }
  </style>
</head>

<body class="admin-page">
  <div class="app-layout">
    <%- include('partials/sidebar', { activeTab: 'users' }) %>
    <div class="main-content-wrapper">

      <!-- Hero Banner Header -->
      <div class="topbar hero-banner folder-header-banner" style="margin-bottom: 24px;">
        <div class="header-left" style="display: flex; flex-direction: column; align-items: flex-start; gap: 4px;">
          <div class="eyebrow" style="margin-top: 4px;"><%= (typeof user !== 'undefined' && user && user.role === 'HR') ? 'HR - People & Culture' : 'Super Admin' %></div>
          <h2 style="margin: 4px 0 6px 0;">User Management</h2>
          <p class="subtitle" style="color: #4B5563 !important; margin: 0;">Create users, assign roles and reset passwords.</p>
        </div>

        <div class="header-right">
        <div class="header-stats-grid">
          <div class="header-stat-card">
            <span class="stat-icon">👤</span>
            <div class="stat-info">
              <span class="stat-value">
                <%= users.length %>
              </span>
              <span class="stat-label">Total Users</span>
            </div>
          </div>
          <div class="header-stat-card">
            <span class="stat-icon">🛡️</span>
            <div class="stat-info">
              <span class="stat-value">
                <%= users.filter(u=>u.role==='SUPER_ADMIN').length %>
              </span>
              <span class="stat-label">Super Admins</span>
            </div>
          </div>
          <div class="header-stat-card">
            <span class="stat-icon">🏷️</span>
            <div class="stat-info">
              <span class="stat-value">
                <%= users.filter(u=>u.role==='TEAM').length %>
              </span>
              <span class="stat-label">Team Users</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
      <% } %>

        <!-- Add User Form -->
        <div class="card glass-panel" style="margin-bottom: 16px;">
          <div class="section-head" style="margin-bottom: 20px;">
            <div>
              <h3>Add User</h3>
              <p class="subtitle">Create a new portal user with a role and optional team assignment.</p>
            </div>
          </div>
          <form method="post" action="/admin/users" class="portal-form">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 16px;">
              <label class="input-label">
                <span>Username *</span>
                <input type="text" name="username" required placeholder="e.g. john_head" />
              </label>
              <label class="input-label">
                <span>Password *</span>
                <input type="password" name="password" required placeholder="Min 8 characters" />
              </label>
              <label class="input-label">
                <span>Role *</span>
                <select name="role" required>
                  <option value="" disabled selected>Select Role...</option>
                  <option value="HEAD">HEAD (Team Head)</option>
                  <option value="TEAM">TEAM</option>
                  <option value="ACCOUNTS">ACCOUNTS</option>
                  <option value="HR">HR - People and Culture</option>
                  <option value="SUPER_ADMIN">SUPER_ADMIN</option>
                </select>
              </label>
              <label class="input-label" id="teamNameInputGroup">
                <span id="teamNameLabel">Team Name (for HEAD & TEAM) *</span>
                <input type="text" name="teamName" id="teamNameInput" placeholder="e.g. TEAM_1" />
              </label>
            </div>

            <div style="margin-top: 16px; display: flex; justify-content: flex-end;">
              <button class="btn btn-3d-nav" type="submit" style="width: auto; min-width: 200px;">+ Create User</button>
            </div>
          </form>
        </div>

        <!-- Users Table -->
        <div class="card glass-panel">
          <div class="section-head" style="margin-bottom: 16px;">
            <div>
              <h3>All Users</h3>
              <p class="subtitle">Manage existing portal users — reset passwords or remove access.</p>
            </div>
            <div class="pill" id="userCountBadge">
              <%= users.length %> users
            </div>
          </div>

          <!-- Role Filter Bar -->
          <div class="user-filters-bar">
            <span class="user-filter-label">⚡ Filter Role:</span>
            <button type="button" class="user-filter-btn active" onclick="filterUsers('ALL', this)">
              All Users <span class="filter-count-badge"><%= users.length %></span>
            </button>
            <button type="button" class="user-filter-btn" onclick="filterUsers('TEAM', this)">
              Team Users <span class="filter-count-badge"><%= users.filter(u => u.role === 'TEAM').length %></span>
            </button>
            <button type="button" class="user-filter-btn" onclick="filterUsers('SUPER_ADMIN', this)">
              Superadmin Users <span class="filter-count-badge"><%= users.filter(u => u.role === 'SUPER_ADMIN').length %></span>
            </button>
            <button type="button" class="user-filter-btn" onclick="filterUsers('HEAD', this)">
              Heads Users <span class="filter-count-badge"><%= users.filter(u => u.role === 'HEAD').length %></span>
            </button>
            <button type="button" class="user-filter-btn" onclick="filterUsers('ACCOUNTS', this)">
              Accounts Users <span class="filter-count-badge"><%= users.filter(u => u.role === 'ACCOUNTS').length %></span>
            </button>
            <button type="button" class="user-filter-btn" onclick="filterUsers('HR', this)">
              HR Users <span class="filter-count-badge"><%= users.filter(u => u.role === 'HR').length %></span>
            </button>
          </div>

          <div class="users-table-wrap">
            <table class="users-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Username</th>
                  <th>Role</th>
                  <th>Team Name</th>
                  <% if (typeof user !== 'undefined' && user && user.role === 'SUPER_ADMIN') { %>
                    <th>Impersonate</th>
                  <% } %>
                  <th>Reset Password</th>
                  <th>Delete</th>
                </tr>
              </thead>
              <tbody id="usersTableBody">
                <% users.forEach((u)=> { %>
                  <tr class="user-row" data-role="<%= u.role %>">
                    <td class="user-id-cell" data-label="#">
                      <%= u.id %>
                    </td>
                    <td data-label="Username">
                      <div class="user-name-cell">
                        <div class="user-avatar" data-name="<%= u.username %>">
                          <%= u.username.charAt(0).toUpperCase() %>
                        </div>
                        <span>
                          <%= u.username %>
                        </span>
                      </div>
                    </td>
                    <td data-label="Role">
                      <span class="role-badge role-<%= u.role.toLowerCase() %>">
                        <%= u.role %>
                      </span>
                    </td>
                    <td class="team-cell" data-label="Team">
                      <%= u.team_name || '—' %>
                    </td>
                    <% if (typeof user !== 'undefined' && user && user.role === 'SUPER_ADMIN') { %>
                      <td data-label="Impersonate">
                        <% if (u.id !== (user ? user.id : 0)) { %>
                          <form method="post" action="/admin/users/<%= u.id %>/impersonate">
                            <button class="btn btn-3d-sm btn-3d-view" type="submit">Impersonate</button>
                          </form>
                        <% } else { %>
                          <span style="color: #9ca3af; font-size: 13px; font-weight: 500;">Current User</span>
                        <% } %>
                      </td>
                    <% } %>
                    <td data-label="Reset Password">
                      <form method="post" action="/admin/users/<%= u.id %>/reset"
                        style="display:flex;gap:8px;align-items:center;">
                        <input type="password" name="newPassword" placeholder="New password" required
                          style="flex:1;min-width:140px;" />
                        <button class="btn btn-3d-sm btn-3d-view" type="submit">Reset</button>
                      </form>
                    </td>
                    <td data-label="Delete">
                      <form method="post" action="/admin/users/<%= u.id %>/delete"
                        onsubmit="return confirm('Delete user <%= u.username %>?')">
                        <button class="btn btn-3d-sm btn-3d-reject" type="submit">Delete</button>
                      </form>
                    </td>
                  </tr>
                  <% }) %>
              </tbody>
            </table>
            <div id="noUsersFilterMessage" class="empty-state" style="display: none; padding: 32px 16px; text-align: center; color: #9CA3AF; font-weight: 500;">
              No users found matching the selected role filter.
            </div>
          </div>
        </div>

        <script>
          window.filterUsers = function (selectedRole, btnElement) {
            if (btnElement) {
              document.querySelectorAll('.user-filter-btn').forEach(btn => btn.classList.remove('active'));
              btnElement.classList.add('active');
            }

            const rows = document.querySelectorAll('#usersTableBody tr.user-row');
            let visibleCount = 0;

            rows.forEach(row => {
              const role = row.getAttribute('data-role');
              if (selectedRole === 'ALL' || role === selectedRole) {
                row.style.display = '';
                visibleCount++;
              } else {
                row.style.display = 'none';
              }
            });

            const countBadge = document.getElementById('userCountBadge');
            if (countBadge) {
              countBadge.innerText = visibleCount + ' users';
            }

            const noMsg = document.getElementById('noUsersFilterMessage');
            if (noMsg) {
              noMsg.style.display = (visibleCount === 0) ? 'block' : 'none';
            }
          };
          window.performCreatorSearch = function () {
            const input = document.getElementById('creatorSearchInput');
            const filter = (input ? input.value : '').toLowerCase().trim();
            const rows = document.querySelectorAll('.creator-ledger-row');
            let visibleCount = 0;

            rows.forEach(row => {
              const searchData = row.getAttribute('data-search') || '';
              if (!filter || searchData.includes(filter)) {
                row.style.display = '';
                visibleCount++;
              } else {
                row.style.display = 'none';
              }
            });

            const badge = document.getElementById('creatorFoundBadge');
            if (badge) {
              badge.innerText = visibleCount + ' records found';
            }
          };

          document.addEventListener("DOMContentLoaded", () => {
            const roleSelect = document.querySelector('select[name="role"]');
            const teamNameInputGroup = document.getElementById("teamNameInputGroup");
            const teamNameInput = document.getElementById("teamNameInput");

            function toggleTeamInput() {
              if (!roleSelect || !teamNameInputGroup) return;
              const isTeamOrHead = roleSelect.value === "TEAM" || roleSelect.value === "HEAD";
              if (isTeamOrHead) {
                teamNameInputGroup.style.opacity = "1";
                teamNameInputGroup.style.filter = "none";
                if (teamNameInput) {
                  teamNameInput.required = true;
                  teamNameInput.placeholder = "e.g. TEAM_1";
                }
              } else {
                teamNameInputGroup.style.opacity = "0.45";
                teamNameInputGroup.style.filter = "grayscale(50%)";
                if (teamNameInput) {
                  teamNameInput.required = false;
                  teamNameInput.value = "";
                  teamNameInput.placeholder = "Optional";
                }
              }
            }

            if (roleSelect) {
              roleSelect.addEventListener("change", toggleTeamInput);
              toggleTeamInput();
            }

            // Feature #16 — Color-coded avatars (deterministic by name hash)
            (function colorAvatars() {
              const PALETTES = [
                ['#7c3aed', '#4f46e5'],
                ['#db2777', '#9333ea'],
                ['#0891b2', '#0e7490'],
                ['#d97706', '#b45309'],
                ['#16a34a', '#15803d'],
                ['#dc2626', '#b91c1c'],
                ['#0284c7', '#0369a1'],
                ['#c026d3', '#a21caf'],
                ['#ea580c', '#c2410c'],
                ['#65a30d', '#4d7c0f'],
              ];
              function hashName(str) {
                let h = 0;
                for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) | 0;
                return Math.abs(h);
              }
              document.querySelectorAll('.user-avatar[data-name]').forEach(el => {
                const name = el.dataset.name || '';
                const [c1, c2] = PALETTES[hashName(name) % PALETTES.length];
                el.style.background = `linear-gradient(135deg, ${c1}, ${c2})`;
              });
            })();
          });
        </script>
    </div>
  </div>
</body>

</html>