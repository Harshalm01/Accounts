<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HR Station — 3Folks Media</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/styles.css?v=46" />
    <style>
      .hr-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
        margin-bottom: 32px;
      }
      .hr-card {
        background: #ffffff;
        border: 1.5px solid rgba(124, 58, 237, 0.15);
        border-radius: 20px;
        padding: 28px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(124, 58, 237, 0.06);
      }
      .hr-card:hover {
        transform: translateY(-4px);
        border-color: #7c3aed;
        box-shadow: 0 16px 36px rgba(124, 58, 237, 0.18);
      }
      .hr-card-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 18px;
      }
      .hr-card-upload-gst { background: rgba(16, 185, 129, 0.12); color: #059669; border: 1px solid rgba(16, 185, 129, 0.25); }
      .hr-card-upload-nongst { background: rgba(236, 72, 153, 0.12); color: #db2777; border: 1px solid rgba(236, 72, 153, 0.25); }
      
      .hr-card h3 {
        font-size: 18px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 6px;
      }
      .hr-card p {
        font-size: 14px;
        color: #64748b;
        line-height: 1.5;
        margin: 0;
      }

      .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999;
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s ease;
      }
      .modal-backdrop.active {
        opacity: 1;
        pointer-events: auto;
      }
      .modal-box {
        background: #ffffff;
        border: 1.5px solid rgba(124, 58, 237, 0.15);
        border-radius: 24px;
        width: 90%;
        max-width: 580px;
        padding: 32px;
        box-shadow: 0 25px 60px rgba(124, 58, 237, 0.18), 0 10px 25px rgba(15, 23, 42, 0.1);
        transform: scale(0.95);
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .modal-backdrop.active .modal-box {
        transform: scale(1);
      }

      .modal-box h2 {
        color: #0f172a !important;
        font-size: 20px !important;
        font-weight: 800 !important;
      }

      .modal-box .input-label {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .modal-box .input-label span {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        color: #7c3aed;
        letter-spacing: 0.6px;
      }
      .modal-box .input-label input,
      .modal-box .input-label textarea {
        background: #f8fafc !important;
        border: 1.5px solid #e2e8f0 !important;
        border-radius: 12px !important;
        padding: 12px 16px !important;
        color: #0f172a !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        font-family: inherit !important;
        transition: all 0.2s ease-in-out !important;
      }
      .modal-box .input-label input::placeholder,
      .modal-box .input-label textarea::placeholder {
        color: #94a3b8 !important;
      }
      .modal-box .input-label input:focus,
      .modal-box .input-label textarea:focus {
        border-color: #7c3aed !important;
        background: #ffffff !important;
        box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.15) !important;
        outline: none !important;
      }
    </style>
  </head>
  <body class="admin-page">
    <div class="app-layout">
      <%- include('partials/sidebar', { activeTab: 'hr_uploads' }) %>
      <div class="main-content-wrapper">

        <!-- TOPBAR HERO BANNER -->
        <div class="topbar hero-banner folder-header-banner" style="margin-bottom: 24px;">
          <div class="header-left" style="display: flex; flex-direction: column; align-items: flex-start; gap: 4px;">
            <div class="eyebrow" style="color: #ec4899; margin-top: 4px; font-weight: 800; text-transform: uppercase; font-size: 11px; letter-spacing: 0.08em;">HR - People & Culture</div>
            <h2 style="margin: 4px 0 6px 0;">HR Uploads & Document Station</h2>
            <p class="subtitle" style="color: #4B5563 !important; margin: 0;">Upload GST and NON-GST invoice vouchers, add custom descriptions, and dispatch to Accounts station.</p>
          </div>

          <div class="header-right">
            <div class="header-stats-grid">
              <div class="header-stat-card">
                <span class="stat-icon">📄</span>
                <div class="stat-info">
                  <span class="stat-value"><%= (typeof hrInvoices !== 'undefined' && hrInvoices) ? hrInvoices.length : 0 %></span>
                  <span class="stat-label">Total HR Uploads</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" style="margin-bottom: 20px; background: rgba(16, 185, 129, 0.15); color: #10B981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 14px 18px; border-radius: 12px; font-weight: 600;">
          ✅ <%= success %>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" style="margin-bottom: 20px; background: rgba(239, 68, 68, 0.15); color: #EF4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 14px 18px; border-radius: 12px; font-weight: 600;">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <!-- HR UPLOAD ACTION OPTIONS (2 CARDS) -->
      <div class="hr-grid">
        <!-- 1. Upload GST Invoice -->
        <div class="hr-card" onclick="openHrModal('uploadGst')">
          <div class="hr-card-icon hr-card-upload-gst">📤</div>
          <h3>1. Upload GST Invoice</h3>
          <p>Directly upload an existing GST invoice document or voucher PDF.</p>
        </div>

        <!-- 2. Upload NON-GST Invoice -->
        <div class="hr-card" onclick="openHrModal('uploadNonGst')">
          <div class="hr-card-icon hr-card-upload-nongst">📁</div>
          <h3>2. Upload NON-GST Invoice</h3>
          <p>Directly upload an existing NON-GST document, bill, or receipt.</p>
        </div>
      </div>

      <!-- COMPLETED & UPLOADED HR INVOICES TABLE -->
      <div class="card glass-panel">
        <div class="section-head" style="margin-bottom: 16px;">
          <div>
            <h3>Uploaded HR Invoices & Document Vouchers</h3>
            <p class="subtitle">History of all uploaded HR invoices and custom notes dispatched to Accounts station.</p>
          </div>
          <div class="pill">
            <%= (typeof hrInvoices !== 'undefined' && hrInvoices) ? hrInvoices.length : 0 %> Documents
          </div>
        </div>

        <div class="users-table-wrap">
          <table class="users-table">
            <thead>
              <tr>
                <th>Invoice #</th>
                <th>Type</th>
                <th>Employee / Vendor Name</th>
                <th>Description / Remarks</th>
                <th>Amount</th>
                <th>Date</th>
                <th>Payment Status</th>
                <th>File / View</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof hrInvoices !== 'undefined' && hrInvoices && hrInvoices.length) { %>
                <% hrInvoices.forEach(inv => { %>
                  <%
                    const st = String(inv.status || '').toUpperCase();
                    const isPaid = st === 'PAID' || st === 'PAYMENT COMPLETED' || !!inv.utr;
                    const isRejected = st === 'REJECTED';
                  %>
                  <tr>
                    <td data-label="Invoice #">
                      <strong style="color: #a78bfa;">#<%= inv.invoice_no %></strong>
                    </td>
                    <td data-label="Type">
                      <span class="pill" style="font-size: 11px; font-weight: 700; background: <%= inv.hr_invoice_type && inv.hr_invoice_type.includes('GST') ? 'rgba(124, 58, 237, 0.2)' : 'rgba(245, 158, 11, 0.2)' %>; color: <%= inv.hr_invoice_type && inv.hr_invoice_type.includes('GST') ? '#c4b5fd' : '#fcd34d' %>;">
                        <%= inv.hr_invoice_type || 'HR Invoice' %>
                      </span>
                    </td>
                    <td data-label="Employee / Vendor">
                      <strong><%= inv.creator_name %></strong><br/>
                      <span style="font-size: 11px; color: #9ca3af;"><%= inv.creator_mobile || '' %></span>
                    </td>
                    <td data-label="Description / Remarks" style="font-size: 13px; color: #d1d5db; max-width: 200px;">
                      <%= inv.other_references || '—' %>
                    </td>
                    <td data-label="Amount">
                      <strong style="color: #10b981;">₹<%= Number(inv.final_amount || inv.total_amount || 0).toLocaleString('en-IN') %></strong>
                    </td>
                    <td data-label="Date">
                      <%= inv.invoice_date || 'N/A' %>
                    </td>
                    <td data-label="Payment Status">
                      <% if (isPaid) { %>
                        <span class="pill" style="font-size: 11px; font-weight: 800; background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); display: inline-block;">
                          ✅ PAYMENT CLEARED
                        </span>
                        <% if (inv.utr) { %>
                          <div style="font-size: 11px; font-family: monospace; color: #34d399; margin-top: 4px; font-weight: 700;">
                            UTR: <%= inv.utr %>
                          </div>
                        <% } %>
                      <% } else if (st === 'ACCEPTED' || st === 'APPROVED') { %>
                        <span class="pill" style="font-size: 11px; font-weight: 800; background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); display: inline-block;">
                          ✅ APPROVED
                        </span>
                      <% } else if (isRejected) { %>
                        <span class="pill" style="font-size: 11px; font-weight: 800; background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); display: inline-block;">
                          ❌ REJECTED
                        </span>
                      <% } else { %>
                        <span class="pill" style="font-size: 11px; font-weight: 800; background: rgba(245, 158, 11, 0.18); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); display: inline-block;">
                          ⌛ PENDING
                        </span>
                      <% } %>
                    </td>
                    <td data-label="Actions / View">
                      <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                        <% if (inv.file_path) { %>
                          <a href="<%= inv.file_path %>" target="_blank" class="btn btn-3d-sm" style="padding: 4px 10px; font-size: 12px;">📁 Open Document</a>
                        <% } else { %>
                          <a href="/admin/invoices/<%= inv.id %>/view" target="_blank" class="btn btn-3d-sm" style="padding: 4px 10px; font-size: 12px;">📄 View Paper</a>
                        <% } %>

                        <% if (typeof user !== 'undefined' && user && (user.role === 'ACCOUNTS' || user.role === 'SUPER_ADMIN')) { %>
                          <% if (st !== 'ACCEPTED' && st !== 'APPROVED' && !isPaid) { %>
                            <form method="POST" action="/admin/invoices/<%= inv.id %>/status" style="display:inline;">
                              <input type="hidden" name="action" value="accept" />
                              <button type="submit" class="btn btn-3d-sm" style="padding: 4px 10px; font-size: 12px; background: #10b981; color: #ffffff; border: none; font-weight: 700; border-radius: 8px;">
                                ✅ Approve
                              </button>
                            </form>
                          <% } %>

                          <% if (!isRejected && !isPaid) { %>
                            <form method="POST" action="/admin/invoices/<%= inv.id %>/status" onsubmit="const r = prompt('Reason for rejection:'); if (!r) return false; this.reason.value = r;" style="display:inline;">
                              <input type="hidden" name="action" value="reject" />
                              <input type="hidden" name="reason" value="" />
                              <button type="submit" class="btn btn-3d-sm" style="padding: 4px 10px; font-size: 12px; background: #ef4444; color: #ffffff; border: none; font-weight: 700; border-radius: 8px;">
                                ❌ Reject
                              </button>
                            </form>
                          <% } %>

                          <% if (!isPaid) { %>
                            <form method="POST" action="/admin/invoices/<%= inv.id %>/status" style="display:inline;">
                              <input type="hidden" name="action" value="payment_completed" />
                              <button type="submit" class="btn btn-3d-sm" style="padding: 4px 10px; font-size: 12px; background: #7c3aed; color: #ffffff; border: none; font-weight: 700; border-radius: 8px;">
                                💳 Payment Cleared
                              </button>
                            </form>
                          <% } %>
                        <% } %>

                        <form method="POST" action="/hr/invoices/<%= inv.id %>/delete" onsubmit="return confirm('Are you sure you want to delete invoice #<%= inv.invoice_no %>? This action cannot be undone.');" style="display: inline;">
                          <button type="submit" class="btn btn-3d-danger" style="padding: 4px 10px; font-size: 12px; border-radius: 8px; background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);">🗑️ Delete</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" style="text-align: center; color: #9ca3af; padding: 32px;">
                    No HR invoice documents uploaded yet. Use the upload cards above to attach an invoice.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- UPLOAD HR INVOICE MODAL -->
    <div class="modal-backdrop" id="uploadInvoiceModal">
      <div class="modal-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
          <h2 id="modalUploadTitle" style="font-size: 20px; font-weight: 800; color: #0f172a;">Upload GST Invoice Document</h2>
          <button type="button" onclick="closeHrModal()" style="background: none; border: none; color: #64748b; font-size: 22px; cursor: pointer;">✕</button>
        </div>

        <form method="POST" action="/hr/invoices/upload" enctype="multipart/form-data" class="portal-form">
          <input type="hidden" id="hrUploadKind" name="invoiceType" value="upload_gst" />

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
            <label class="input-label">
              <span>Invoice # *</span>
              <input type="text" name="invoiceNo" required placeholder="e.g. HR-INV-UP01" />
            </label>
            <label class="input-label">
              <span>Employee / Vendor Name *</span>
              <input type="text" name="creatorName" required placeholder="Full Name" />
            </label>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
            <label class="input-label">
              <span>Total Amount (₹) *</span>
              <input type="number" step="0.01" name="amount" required placeholder="0.00" />
            </label>
            <label class="input-label">
              <span>Date *</span>
              <input type="date" name="invoiceDate" required value="<%= new Date().toISOString().split('T')[0] %>" />
            </label>
          </div>

          <div style="margin-bottom: 14px;">
            <label class="input-label">
              <span>Description / Remarks</span>
              <textarea name="description" rows="2" placeholder="Add notes, project name, or payment remarks..."></textarea>
            </label>
          </div>

          <div style="margin-bottom: 18px;">
            <label class="input-label">
              <span>Select Document File (PDF / Image) *</span>
              <input type="file" name="invoiceFile" required accept=".pdf,.png,.jpg,.jpeg" style="padding: 10px; background: rgba(255,255,255,0.05); border-radius: 8px;" />
            </label>
          </div>

          <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px;">
            <button type="button" class="btn-cancel" onclick="closeHrModal()">Cancel</button>
            <button type="submit" class="btn btn-3d-nav">Upload Voucher</button>
          </div>
        </form>
      </div>
    </div>

    <script>
      function openHrModal(type) {
        if (type === 'uploadGst') {
          document.getElementById('modalUploadTitle').innerText = '1. Upload GST Invoice Document';
          document.getElementById('hrUploadKind').value = 'upload_gst';
          document.getElementById('uploadInvoiceModal').classList.add('active');
        } else if (type === 'uploadNonGst') {
          document.getElementById('modalUploadTitle').innerText = '2. Upload NON-GST Invoice Document';
          document.getElementById('hrUploadKind').value = 'upload_nongst';
          document.getElementById('uploadInvoiceModal').classList.add('active');
        }
      }

      function closeHrModal() {
        document.getElementById('uploadInvoiceModal').classList.remove('active');
      }
    </script>
      </div>
    </div>
  </body>
</html>
