<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Campaigns — 3Folks Media</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/styles.css?v=45" />
  </head>
  <body class="admin-page">
    <div class="app-layout">
      <%- include('partials/sidebar', { activeTab: 'campaigns' }) %>
      <div class="main-content-wrapper">

        <!-- Hero Banner Header -->
        <div class="topbar hero-banner folder-header-banner" style="margin-bottom: 24px;">
          <div class="header-left">
            <div class="eyebrow">Team workspace</div>
            <h2 style="margin: 8px 0 6px 0;">Campaigns</h2>
            <p class="subtitle" style="color: #4B5563 !important;"><%= typeof canEdit !== 'undefined' && canEdit ? 'Create campaigns and map creators by serial number.' : 'View campaign folders and mapped creators.' %></p>
          </div>

          <div class="header-right">
          <div class="header-stats-grid">
            <div class="header-stat-card">
              <span class="stat-icon">📣</span>
              <div class="stat-info">
                <span class="stat-value"><%= campaigns.length %></span>
                <span class="stat-label">Total Campaigns</span>
              </div>
            </div>
            <div class="header-stat-card">
              <span class="stat-icon">👥</span>
              <div class="stat-info">
                <span class="stat-value"><%= campaigns.reduce((s,c)=>s+(c.creator_count||0),0) %></span>
                <span class="stat-label">Total Creators</span>
              </div>
            </div>
            <div class="header-stat-card">
              <span class="stat-icon">💰</span>
              <div class="stat-info">
                <span class="stat-value">₹<%= Number(campaigns.reduce((s,c)=>s+Number(c.amount||0),0)).toLocaleString('en-IN',{minimumFractionDigits:0,maximumFractionDigits:0}) %></span>
                <span class="stat-label">Total Payout</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Navigation Bar -->
      <div class="nav nav-3d" style="margin-bottom: 20px;">
        <a href="/admin/dashboard"><button class="btn btn-3d-nav" type="button">Invoices</button></a>
        <% if (user.role==='ACCOUNTS' || user.role==='SUPER_ADMIN' ) { %>
          <a href="/admin/dashboard?tab=hr_uploads"><button class="btn btn-3d-nav" type="button">💼 HR Uploads</button></a>
        <% } %>
        <% if (user.role==='ACCOUNTS' || user.role==='SUPER_ADMIN' || user.role==='TEAM' || user.role==='HEAD' ) { %>
          <a href="/admin/folders"><button class="btn btn-3d-nav" type="button">Folders</button></a>
        <% } %>
        <% if (user.role==='ACCOUNTS' || user.role==='SUPER_ADMIN' ) { %>
          <a href="/admin/notifications"><button class="btn btn-3d-nav" type="button">Notifications</button></a>
        <% } %>
        <% if (user.role==='HEAD' || user.role==='SUPER_ADMIN' ) { %>
          <a href="/admin/campaigns"><button class="btn btn-3d-nav active" type="button" style="background: #7c3aed; color: #ffffff; border-color: #7c3aed; font-weight: 800;">Campaigns</button></a>
        <% } %>
        <% if (user.role==='SUPER_ADMIN' ) { %>
          <a href="/admin/users"><button class="btn btn-3d-nav" type="button">Users</button></a>
        <% } %>
        <a href="/admin/fun"><button class="btn btn-3d-nav" type="button">🎉 Fun Tab</button></a>
      </div>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <!-- Add Campaign Form -->
      <% if (typeof canEdit !== 'undefined' && canEdit) { %>
        <div class="card glass-panel" style="margin-bottom: 16px;">
          <div class="section-head" style="margin-bottom: 20px;">
            <div>
              <h3>Add Campaign</h3>
              <p class="subtitle">Fill in campaign details, brand name, external budget and assigned team.</p>
            </div>
          </div>
          <form method="post" action="/admin/campaigns" class="grid-3" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:16px;">
            <label class="input-label">
              <span>Brand Name *</span>
              <input type="text" name="brandName" required placeholder="e.g. Nike, Samsung..." />
            </label>
            <label class="input-label">
              <span>Campaign Name *</span>
              <input type="text" name="campaignName" required placeholder="e.g. Kaamil Phase 3" />
            </label>
            <label class="input-label">
              <span>Campaign Code *</span>
              <input type="text" name="campaignCode" required placeholder="e.g. 3FM-CC-40" />
            </label>
            <label class="input-label">
              <span>External Budget (₹)</span>
              <input type="number" step="0.01" name="externalBudget" placeholder="e.g. 100000" />
            </label>
            <% if (user.role === 'SUPER_ADMIN') { %>
              <label class="input-label">
                <span>Team Name</span>
                <input type="text" name="teamName" placeholder="TEAM_1" />
              </label>
            <% } %>
            <div style="align-self: end;">
              <button class="btn btn-3d-nav" type="submit" style="width:100%;">+ Create Campaign</button>
            </div>
          </form>
        </div>
      <% } %>

      <!-- Filter -->
      <div class="card glass-panel" style="margin-bottom: 16px;">
        <form method="get" action="/admin/campaigns" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
          <label class="input-label" style="flex:1;min-width:220px;">
            <span>Search by name / brand / code / team</span>
            <input type="text" name="search" value="<%= search || '' %>" placeholder="Kaamil, 3FM-CC-40…" />
          </label>
          <div style="display:flex;gap:8px;padding-bottom:2px;">
            <button class="btn btn-3d-nav" type="submit">Filter</button>
            <a href="/admin/campaigns"><button class="btn btn-3d-sm btn-3d-open" type="button" style="transform:none;">Clear</button></a>
            <button class="btn btn-3d-sm btn-3d-open" type="button" id="sortAlphabeticalBtn" onclick="toggleAlphabeticalSort()" style="transform:none; background: linear-gradient(135deg, #7c3aed, #4f46e5); color:#fff; border:none; font-weight:700;">
              🔤 Sort A-Z
            </button>
          </div>
        </form>
      </div>

      <!-- Campaign List -->
      <div class="card glass-panel">
        <div class="section-head" style="margin-bottom: 20px;">
          <div>
            <h3>Campaign Folders</h3>
            <p class="subtitle">Click a campaign to view creators, budgets and pending payouts.</p>
          </div>
          <div class="pill"><%= campaigns.length %> campaigns</div>
        </div>

        <% if (!campaigns.length) { %>
          <div class="empty-state">No campaigns match your filter.</div>
        <% } %>

        <div class="folder-grid folder-grid-books" id="campaignFolderGrid" style="margin-top: 16px;">
          <% campaigns.forEach((c) => { %>
            <% 
              const totalCr = c.creators ? c.creators.length : 0;
              const paidCr = c.paidCreatorsCount || 0;
              const pendingCr = c.pendingCreatorsCount || (totalCr - paidCr);
              const paidPct = totalCr > 0 ? Math.round((paidCr / totalCr) * 100) : 0;
            %>
            <div class="folder-card-wrap" data-name="<%= (c.campaign_name || '').toLowerCase() %>">
              <a class="book" href="/admin/campaigns/<%= c.id %>/creators">

                <!-- Inside of Book (creators list) -->
                <div class="inside-page">
                  <div class="inside-header">Creators · <%= totalCr %></div>
                  <div class="inside-creators-list">
                    <% if (c.creators && c.creators.length) { %>
                      <% c.creators.forEach((cr) => { %>
                        <div class="inside-creator-row">
                          <span class="inside-creator-name"><%= cr.creator_name %></span>
                          <span class="inside-creator-amount">₹<%= Number(cr.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) %></span>
                        </div>
                      <% }) %>
                    <% } else { %>
                      <div style="color:#a78bfa;font-size:13px;margin-top:16px;text-align:center;">No creators mapped</div>
                    <% } %>
                  </div>
                </div>

                <!-- Cover of Book (campaign summary) -->
                <div class="cover">
                  <div>
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                      <span class="cover-tag"><%= c.brand_name || 'Campaign' %></span>
                      <span style="font-size:11px; font-weight:800; color:#7c3aed;"><%= c.team_name %></span>
                    </div>
                    <h3 class="cover-title" style="margin-top:4px;"><%= c.campaign_name %></h3>
                    <p style="font-size:11px;color:#6B7280;margin:0 0 10px 0;">Code: <strong><%= c.campaign_code %></strong></p>
                  </div>

                  <!-- Internal & External Budget -->
                  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:8px 10px; margin-bottom:10px; font-size:11px;">
                    <div>
                      <span style="color:#64748b; font-weight:600; display:block;">External Budget</span>
                      <strong style="color:#0f172a; font-size:12px;">₹<%= Number(c.external_budget || 0).toLocaleString('en-IN') %></strong>
                    </div>
                    <div>
                      <span style="color:#64748b; font-weight:600; display:block;">Internal (Calculated)</span>
                      <strong style="color:#7c3aed; font-size:12px;">₹<%= Number(c.internalBudget || c.amount || 0).toLocaleString('en-IN') %></strong>
                    </div>
                  </div>

                  <!-- Pending Payout Bar Chart -->
                  <div style="background:#ffffff; border:1px solid #e2e8f0; border-radius:10px; padding:10px; margin-bottom:10px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; font-size:11px; font-weight:700; margin-bottom:6px;">
                      <span style="color:#059669;">Paid: <%= paidCr %> (₹<%= Number(c.paidPayout || 0).toLocaleString('en-IN') %>)</span>
                      <span style="color:#d97706;">Pending: <%= pendingCr %> (₹<%= Number(c.pendingPayout || 0).toLocaleString('en-IN') %>)</span>
                    </div>
                    <div style="width:100%; height:8px; background:#fef3c7; border-radius:4px; overflow:hidden; display:flex;">
                      <div style="width:<%= paidPct %>%; height:100%; background:linear-gradient(90deg, #10b981, #059669); transition:width 0.3s ease;"></div>
                    </div>
                    <div style="font-size:10px; color:#64748b; margin-top:4px; text-align:right; font-weight:600;">
                      <%= paidPct %>% Payout Settled
                    </div>
                  </div>

                  <% if (user.role === 'HEAD' || user.role === 'SUPER_ADMIN' || user.role === 'ACCOUNTS') { %>
                    <div style="margin-top: 6px; text-align: right;">
                      <form method="post" action="/admin/campaigns/<%= c.id %>/delete" onsubmit="return confirm('⚠️ Are you sure you want to delete campaign &quot;<%= c.campaign_name %>&quot;? All mapped creators and invoices will be permanently deleted.');" style="display:inline;" onclick="event.stopPropagation();">
                        <button type="submit" class="btn btn-3d-sm" style="background:#fee2e2; color:#b91c1c; border:1px solid #fca5a5; font-weight:800; font-size:10px; padding:4px 10px; border-radius:6px; cursor:pointer;">
                          🗑️ Delete Campaign
                        </button>
                      </form>
                    </div>
                  <% } %>
                </div>

              </a>
            </div>
          <% }) %>
        </div>
      </div>

    </div>

    <script>
      let isAscending = true;
      function toggleAlphabeticalSort() {
        const grid = document.getElementById("campaignFolderGrid");
        const btn = document.getElementById("sortAlphabeticalBtn");
        if (!grid || !btn) return;

        const cards = Array.from(grid.querySelectorAll(".folder-card-wrap"));
        cards.sort((a, b) => {
          const nameA = a.getAttribute("data-name") || "";
          const nameB = b.getAttribute("data-name") || "";
          return isAscending ? nameA.localeCompare(nameB) : nameB.localeCompare(nameA);
        });

        cards.forEach((card) => grid.appendChild(card));
        btn.innerHTML = isAscending ? "🔤 Sort Z-A" : "🔤 Sort A-Z";
        isAscending = !isAscending;
      }
    </script>
      </div>
    </div>
  </body>
</html>
