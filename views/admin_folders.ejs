<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Folders</title>
    <link rel="stylesheet" href="/public/styles.css?v=45" />
  </head>
  <body class="admin-page">
    <div class="shell">
      <div class="topbar hero-banner folder-header-banner">
        <div class="header-left">
          <%- include('partials/brand') %>
          <div class="eyebrow">Accounts storage</div>
          <h2 style="margin: 8px 0 6px 0;">Campaign Folders</h2>
          <p class="subtitle" style="color: #4B5563 !important;">Campaign folders are created automatically when a campaign is added.</p>
        </div>
        
        <div class="header-right">
          <div class="header-actions-row">
            <form method="post" action="/admin/logout" style="display:inline;">
              <button class="btn btn-3d-nav" type="submit" style="background: linear-gradient(135deg, #ef4444, #dc2626); color:#ffffff; border:none; font-weight:800; letter-spacing:0.05em;">LOGOUT</button>
            </form>
          </div>
          
          <div class="header-stats-grid">
            <div class="header-stat-card">
              <span class="stat-icon">📁</span>
              <div class="stat-info">
                <span class="stat-value"><%= folders.length %></span>
                <span class="stat-label">Total Folders</span>
              </div>
            </div>
            
            <div class="header-stat-card">
              <span class="stat-icon">👥</span>
              <div class="stat-info">
                <% 
                  let totalCreators = folders.reduce((sum, f) => sum + (f.creatorCount || 0), 0);
                %>
                <span class="stat-value"><%= totalCreators %></span>
                <span class="stat-label">Mapped Creators</span>
              </div>
            </div>

            <div class="header-stat-card">
              <span class="stat-icon">📄</span>
              <div class="stat-info">
                <% 
                  let totalInvoices = folders.reduce((sum, f) => sum + (f.invoiceCount || 0), 0);
                %>
                <span class="stat-value"><%= totalInvoices %></span>
                <span class="stat-label">Total Invoices</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Navigation Bar -->
      <div class="nav nav-3d" style="margin-bottom: 20px;">
        <a href="/admin/dashboard"><button class="btn btn-3d-nav" type="button">Invoices</button></a>
        <% if (user.role==='ACCOUNTS' || user.role==='SUPER_ADMIN' ) { %>
          <a href="/admin/dashboard?tab=hr_uploads"><button class="btn btn-3d-nav" type="button">💼 HR Uploads</button></a>
        <% } %>
        <% if (user.role==='ACCOUNTS' || user.role==='SUPER_ADMIN' || user.role==='TEAM' || user.role==='HEAD' ) { %>
          <a href="/admin/folders"><button class="btn btn-3d-nav active" type="button" style="background: #7c3aed; color: #ffffff; border-color: #7c3aed; font-weight: 800;">Folders</button></a>
        <% } %>
        <% if (user.role==='ACCOUNTS' || user.role==='SUPER_ADMIN' ) { %>
          <a href="/admin/notifications"><button class="btn btn-3d-nav" type="button">Notifications</button></a>
        <% } %>
        <% if (user.role==='HEAD' || user.role==='SUPER_ADMIN' ) { %>
          <a href="/admin/campaigns"><button class="btn btn-3d-nav" type="button">Campaigns</button></a>
        <% } %>
        <% if (user.role==='SUPER_ADMIN' ) { %>
          <a href="/admin/users"><button class="btn btn-3d-nav" type="button">Users</button></a>
        <% } %>
        <a href="/admin/fun"><button class="btn btn-3d-nav" type="button">🎉 Fun Tab</button></a>
      </div>

      <div class="card glass-panel">
        <div class="section-head" style="margin-bottom: 20px;">
          <div>
            <h3>Available folders</h3>
            <p class="subtitle">Each campaign folder now shows the mapped creators inside the card.</p>
          </div>
          <div class="pill"><%= folders.length %> folders</div>
        </div>

        <!-- Search Bar -->
        <div class="folder-search-wrap">
          <span class="folder-search-icon">🔍</span>
          <input type="text" id="folderSearch" class="folder-search-input" placeholder="Search campaign name..." autocomplete="off" />
          <div class="folder-search-kbd" id="searchKbd">/</div>
          <button type="button" class="folder-search-clear" id="searchClearBtn" style="display: none;">×</button>
          <span class="folder-search-feedback" id="searchFeedback" style="display: none;"></span>
        </div>

        <% if (!folders.length) { %>
          <div class="empty-state">No campaign folders found yet.</div>
        <% } %>

        <div class="folder-grid folder-grid-books">
          <% folders.forEach((folder) => { %>
            <% 
              const totalCr = folder.creatorCount || 0;
              const paidCr = folder.paidCreatorsCount || 0;
              const pendingCr = folder.pendingCreatorsCount || (totalCr - paidCr);
              const paidPct = totalCr > 0 ? Math.round((paidCr / totalCr) * 100) : 0;
            %>
            <div class="folder-card-wrap" data-name="<%= folder.campaignName.toLowerCase() %>">
              <a class="book" href="/admin/campaigns/<%= folder.id %>/creators?from=folders">

                <!-- Inside of Book (creators list) -->
                <div class="inside-page">
                  <div class="inside-header">Creators · <%= totalCr %></div>
                  <div class="inside-creators-list">
                    <% if (folder.creators && folder.creators.length) { %>
                      <% folder.creators.forEach((c) => { %>
                        <div class="inside-creator-row">
                          <span class="inside-creator-name"><%= c.creator_name %></span>
                          <span class="inside-creator-amount">₹<%= Number(c.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) %></span>
                        </div>
                      <% }) %>
                    <% } else { %>
                      <div style="color:#a78bfa;font-size:13px;margin-top:16px;text-align:center;">No creators mapped</div>
                    <% } %>
                  </div>
                </div>

                <!-- Cover of Book (campaign summary) -->
                <div class="cover">
                  <div>
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                      <span class="cover-tag"><%= folder.brandName || 'Campaign' %></span>
                      <span style="font-size:11px; font-weight:800; color:#7c3aed;"><%= folder.teamName %></span>
                    </div>
                    <h3 class="cover-title" style="margin-top:4px;"><%= folder.campaignName %></h3>
                    <p style="font-size:11px;color:#6B7280;margin:0 0 10px 0;">Code: <strong><%= folder.campaignCode %></strong></p>
                  </div>

                  <!-- Internal & External Budget -->
                  <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:8px 10px; margin-bottom:10px; font-size:11px;">
                    <div>
                      <span style="color:#64748b; font-weight:600; display:block;">External Budget</span>
                      <strong style="color:#0f172a; font-size:12px;">₹<%= Number(folder.externalBudget || 0).toLocaleString('en-IN') %></strong>
                    </div>
                    <div>
                      <span style="color:#64748b; font-weight:600; display:block;">Internal (Calculated)</span>
                      <strong style="color:#7c3aed; font-size:12px;">₹<%= Number(folder.internalBudget || folder.totalAmount || 0).toLocaleString('en-IN') %></strong>
                    </div>
                  </div>

                  <!-- Pending Payout Bar Chart -->
                  <div style="background:#ffffff; border:1px solid #e2e8f0; border-radius:10px; padding:10px; margin-bottom:10px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; font-size:11px; font-weight:700; margin-bottom:6px;">
                      <span style="color:#059669;">Paid: <%= paidCr %> (₹<%= Number(folder.paidPayout || 0).toLocaleString('en-IN') %>)</span>
                      <span style="color:#d97706;">Pending: <%= pendingCr %> (₹<%= Number(folder.pendingPayout || 0).toLocaleString('en-IN') %>)</span>
                    </div>
                    <div style="width:100%; height:8px; background:#fef3c7; border-radius:4px; overflow:hidden; display:flex;">
                      <div style="width:<%= paidPct %>%; height:100%; background:linear-gradient(90deg, #10b981, #059669); transition:width 0.3s ease;"></div>
                    </div>
                    <div style="font-size:10px; color:#64748b; margin-top:4px; text-align:right; font-weight:600;">
                      <%= paidPct %>% Payout Settled
                    </div>
                  </div>

                  <% if (user.role === 'HEAD' || user.role === 'SUPER_ADMIN' || user.role === 'ACCOUNTS') { %>
                    <div style="margin-top: 6px; text-align: right;">
                      <form method="post" action="/admin/campaigns/<%= folder.id %>/delete" onsubmit="return confirm('⚠️ Are you sure you want to delete campaign &quot;<%= folder.campaignName %>&quot;? All mapped creators and invoices will be permanently deleted.');" style="display:inline;" onclick="event.stopPropagation();">
                        <button type="submit" class="btn btn-3d-sm" style="background:#fee2e2; color:#b91c1c; border:1px solid #fca5a5; font-weight:800; font-size:10px; padding:4px 10px; border-radius:6px; cursor:pointer;">
                          🗑️ Delete Campaign
                        </button>
                      </form>
                    </div>
                  <% } %>
                </div>

              </a>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <script>
      const searchInput = document.getElementById("folderSearch");
      const clearBtn = document.getElementById("searchClearBtn");
      const kbd = document.getElementById("searchKbd");
      const feedback = document.getElementById("searchFeedback");
      const cards = document.querySelectorAll(".folder-card-wrap");

      function updateSearch() {
        const term = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;

        cards.forEach((card) => {
          const name = card.getAttribute("data-name") || "";
          if (name.includes(term)) {
            card.style.display = "";
            visibleCount++;
          } else {
            card.style.display = "none";
          }
        });

        // Toggle clear button
        if (term) {
          clearBtn.style.display = "block";
          feedback.style.display = "block";
          feedback.textContent = `${visibleCount} found`;
        } else {
          clearBtn.style.display = "none";
          feedback.style.display = "none";
        }
      }

      if (searchInput) {
        searchInput.addEventListener("input", updateSearch);

        // Keyboard Shortcut: press "/" to focus search
        document.addEventListener("keydown", (e) => {
          if (e.key === "/" && document.activeElement !== searchInput) {
            e.preventDefault();
            searchInput.focus();
          }
        });

        // Clear button action
        if (clearBtn) {
          clearBtn.addEventListener("click", () => {
            searchInput.value = "";
            updateSearch();
            searchInput.focus();
          });
        }
      }
    </script>
  </body>
</html>
