<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Folders</title>
    <link rel="stylesheet" href="/public/styles.css?v=45" />
    <style>
      .brand-modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(8px);
        z-index: 1000;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity 0.25s ease;
      }
      .brand-modal-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 28px;
        width: 92%;
        max-width: 640px;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: 0 25px 60px rgba(15, 23, 42, 0.2);
        border: 1px solid rgba(15, 23, 42, 0.08);
        transform: scale(0.95);
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .campaign-item-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 16px;
        transition: all 0.2s ease;
      }
      .campaign-item-card:hover {
        background: #ffffff;
        border-color: #cbd5e1;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
        transform: translateY(-1px);
      }
    </style>
  </head>
  <body class="admin-page">
    <div class="app-layout">
      <%- include('partials/sidebar', { activeTab: 'folders' }) %>
      <div class="main-content-wrapper">
        <div class="topbar hero-banner folder-header-banner" style="margin-bottom: 24px;">
          <div class="header-left">
            <div class="eyebrow">Accounts storage</div>
            <h2 style="margin: 8px 0 6px 0;">Campaign Folders</h2>
            <p class="subtitle" style="color: #4B5563 !important;">Campaign folders are organized by Brand Name. Click any brand to view its campaigns.</p>
          </div>
          
          <div class="header-right">
            <div class="header-stats-grid">
              <div class="header-stat-card">
                <span class="stat-icon">📁</span>
                <div class="stat-info">
                  <span class="stat-value"><%= folders.length %></span>
                  <span class="stat-label">Brand Folders</span>
                </div>
              </div>
              
              <div class="header-stat-card">
                <span class="stat-icon">👥</span>
                <div class="stat-info">
                  <% 
                    let totalCreators = folders.reduce((sum, f) => sum + (f.creatorCount || 0), 0);
                  %>
                  <span class="stat-value"><%= totalCreators %></span>
                  <span class="stat-label">Mapped Creators</span>
                </div>
              </div>

              <div class="header-stat-card">
                <span class="stat-icon">📄</span>
                <div class="stat-info">
                  <% 
                    let totalInvoices = folders.reduce((sum, f) => sum + (f.invoiceCount || 0), 0);
                  %>
                  <span class="stat-value"><%= totalInvoices %></span>
                  <span class="stat-label">Total Invoices</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="card glass-panel">
          <div class="section-head" style="margin-bottom: 20px;">
            <div>
              <h3>Brand Folders</h3>
              <p class="subtitle">Click on any brand folder card to open all campaigns related to it.</p>
            </div>
            <div class="pill"><%= folders.length %> Brand Folders</div>
          </div>

          <!-- Search Bar -->
          <div class="folder-search-wrap">
            <span class="folder-search-icon">🔍</span>
            <input type="text" id="folderSearch" class="folder-search-input" placeholder="Search brand or campaign name..." autocomplete="off" />
            <div class="folder-search-kbd" id="searchKbd">/</div>
            <button type="button" class="folder-search-clear" id="searchClearBtn" style="display: none;">×</button>
            <span class="folder-search-feedback" id="searchFeedback" style="display: none;"></span>
          </div>

          <% if (!folders.length) { %>
            <div class="empty-state">No campaign folders found yet.</div>
          <% } %>

          <div class="folder-grid folder-grid-books">
            <% folders.forEach((folder, idx) => { %>
              <% 
                const totalCr = folder.creatorCount || 0;
                const paidCr = folder.paidCreatorsCount || 0;
                const pendingCr = folder.pendingCreatorsCount || (totalCr - paidCr);
                const paidPct = totalCr > 0 ? Math.round((paidCr / totalCr) * 100) : 0;
                const searchKeys = (folder.brandName + ' ' + folder.campaignName + ' ' + folder.campaignCode).toLowerCase();
              %>
              <div class="folder-card-wrap" data-name="<%= searchKeys %>">
                <div class="book" onclick="openBrandModal(<%= idx %>)" style="cursor: pointer;">

                  <!-- Inside of Book (creators list) -->
                  <div class="inside-page">
                    <div class="inside-header">Brand Creators · <%= totalCr %></div>
                    <div class="inside-creators-list">
                      <% if (folder.creators && folder.creators.length) { %>
                        <% folder.creators.forEach((c) => { %>
                          <div class="inside-creator-row">
                            <span class="inside-creator-name"><%= c.creator_name %> <small style="color:#94a3b8; font-size:10px;">(<%= c.campaign_name || '' %>)</small></span>
                            <span class="inside-creator-amount">₹<%= Number(c.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) %></span>
                          </div>
                        <% }) %>
                      <% } else { %>
                        <div style="color:#a78bfa;font-size:13px;margin-top:16px;text-align:center;">No creators mapped</div>
                      <% } %>
                    </div>
                  </div>

                  <!-- Cover of Book (brand folder summary) -->
                  <div class="cover">
                    <div>
                      <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span class="cover-tag">🏷️ <%= folder.brandName || 'Brand Folder' %></span>
                        <span style="font-size:11px; font-weight:800; color:#7c3aed; background:rgba(124, 58, 237, 0.1); padding:2px 8px; border-radius:12px;"><%= folder.campaignsCount || 1 %> Campaign<%= (folder.campaignsCount || 1) === 1 ? '' : 's' %></span>
                      </div>
                      <h3 class="cover-title" style="margin-top:8px; font-size:20px; font-weight:800; color:#0f172a;"><%= folder.brandName %></h3>
                      <% if (folder.campaigns && folder.campaigns.length > 0) { %>
                        <p style="font-size:12px; color:#475569; margin:4px 0 12px 0; font-weight:600; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;" title="<%= folder.campaigns.map(c => c.name).join(', ') %>">
                          📁 <%= folder.campaigns.map(c => c.name).join(' • ') %>
                        </p>
                      <% } %>
                    </div>

                    <!-- Internal & External Budget -->
                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:8px 10px; margin-bottom:10px; font-size:11px;">
                      <div>
                        <span style="color:#64748b; font-weight:600; display:block;">External Budget</span>
                        <strong style="color:#0f172a; font-size:12px;">₹<%= Number(folder.externalBudget || 0).toLocaleString('en-IN') %></strong>
                      </div>
                      <div>
                        <span style="color:#64748b; font-weight:600; display:block;">Internal (Calculated)</span>
                        <strong style="color:#7c3aed; font-size:12px;">₹<%= Number(folder.internalBudget || folder.totalAmount || 0).toLocaleString('en-IN') %></strong>
                      </div>
                    </div>

                    <!-- Pending Payout Bar Chart -->
                    <div style="background:#ffffff; border:1px solid #e2e8f0; border-radius:10px; padding:10px; margin-bottom:10px;">
                      <div style="display:flex; justify-content:space-between; align-items:center; font-size:11px; font-weight:700; margin-bottom:6px;">
                        <span style="color:#059669;">Paid: <%= paidCr %> (₹<%= Number(folder.paidPayout || 0).toLocaleString('en-IN') %>)</span>
                        <span style="color:#d97706;">Pending: <%= pendingCr %> (₹<%= Number(folder.pendingPayout || 0).toLocaleString('en-IN') %>)</span>
                      </div>
                      <div style="width:100%; height:8px; background:#fef3c7; border-radius:4px; overflow:hidden; display:flex;">
                        <div style="width:<%= paidPct %>%; height:100%; background:linear-gradient(90deg, #10b981, #059669); transition:width 0.3s ease;"></div>
                      </div>
                      <div style="font-size:10px; color:#64748b; margin-top:4px; text-align:right; font-weight:600;">
                        <%= paidPct %>% Payout Settled
                      </div>
                    </div>

                    <div style="margin-top: 10px; text-align: center;">
                      <span class="btn btn-3d-sm" style="background:#7c3aed; color:#ffffff; font-weight:800; font-size:11px; padding:6px 14px; border-radius:8px; display:inline-block;">
                        📂 View Campaigns (<%= folder.campaignsCount || 1 %>) →
                      </span>
                    </div>
                  </div>

                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Brand Campaigns Modal -->
    <div class="brand-modal-overlay" id="brandModal" onclick="if(event.target===this) closeBrandModal()">
      <div class="brand-modal-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; border-bottom:1px solid #e2e8f0; padding-bottom:12px;">
          <div>
            <span style="font-size:11px; font-weight:800; color:#7c3aed; background:rgba(124, 58, 237, 0.1); padding:2px 8px; border-radius:10px;" id="brandModalTag">🏷️ BRAND FOLDER</span>
            <h2 id="brandModalTitle" style="margin:4px 0 0 0; font-size:22px; font-weight:800; color:#0f172a;">Brand Name</h2>
          </div>
          <button type="button" onclick="closeBrandModal()" style="background:#f1f5f9; border:none; width:32px; height:32px; border-radius:50%; font-size:16px; font-weight:700; color:#64748b; cursor:pointer;">×</button>
        </div>

        <div id="brandModalCampaignsList" style="display:flex; flex-direction:column; gap:12px;">
          <!-- Populated dynamically via JS -->
        </div>
      </div>
    </div>

    <script>
      const ALL_FOLDERS = <%- JSON.stringify(folders) %>;
      const userCanEdit = <%= (user && (user.role === 'HEAD' || user.role === 'SUPER_ADMIN' || user.role === 'ACCOUNTS')) ? 'true' : 'false' %>;

      function openBrandModal(idx) {
        const folder = ALL_FOLDERS[idx];
        if (!folder) return;

        document.getElementById("brandModalTag").textContent = `🏷️ BRAND FOLDER • ${folder.campaignsCount || 1} CAMPAIGN(S)`;
        document.getElementById("brandModalTitle").textContent = folder.brandName || "Brand Folder";

        const listEl = document.getElementById("brandModalCampaignsList");
        listEl.innerHTML = "";

        if (folder.campaigns && folder.campaigns.length > 0) {
          folder.campaigns.forEach(c => {
            const card = document.createElement("div");
            card.className = "campaign-item-card";
            card.innerHTML = `
              <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
                <div>
                  <h4 style="margin:0; font-size:16px; font-weight:800; color:#0f172a;">📁 ${c.name}</h4>
                  <p style="margin:2px 0 0 0; font-size:12px; font-weight:700; color:#7c3aed;">
                    Code: <span style="background:#ffffff; padding:2px 8px; border-radius:6px; border:1px solid #cbd5e1; font-family:monospace; color:#334155;">${c.code}</span>
                  </p>
                </div>
                <span style="font-size:11px; font-weight:800; color:#7c3aed; background:rgba(124, 58, 237, 0.1); padding:2px 8px; border-radius:10px;">
                  Team: ${c.teamName || '—'}
                </span>
              </div>

              <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:8px; background:#ffffff; border:1px solid #e2e8f0; border-radius:10px; padding:8px 10px; margin-bottom:12px; font-size:11px;">
                <div>
                  <span style="color:#64748b; font-weight:600; display:block;">External Budget</span>
                  <strong style="color:#0f172a; font-size:12px;">₹${Number(c.externalBudget || 0).toLocaleString('en-IN')}</strong>
                </div>
                <div>
                  <span style="color:#64748b; font-weight:600; display:block;">Internal Budget</span>
                  <strong style="color:#7c3aed; font-size:12px;">₹${Number(c.internalBudget || 0).toLocaleString('en-IN')}</strong>
                </div>
                <div>
                  <span style="color:#64748b; font-weight:600; display:block;">Creators</span>
                  <strong style="color:#059669; font-size:12px;">👥 ${c.creatorCount || 0}</strong>
                </div>
              </div>

              <div style="display:flex; justify-content:space-between; align-items:center;">
                <a href="/admin/campaigns/${c.id}/creators?from=folders" class="btn btn-3d-sm" style="background:#7c3aed; color:#ffffff; font-weight:800; font-size:12px; padding:6px 14px; border-radius:8px; text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
                  👥 Open Creators & Invoices →
                </a>

                ${userCanEdit ? `
                  <form method="post" action="/admin/campaigns/${c.id}/delete" onsubmit="return confirm('⚠️ Are you sure you want to delete campaign &quot;${c.name}&quot;? All mapped creators and invoices will be permanently deleted.');" style="margin:0;">
                    <button type="submit" class="btn btn-3d-sm" style="background:#fee2e2; color:#b91c1c; border:1px solid #fca5a5; font-weight:800; font-size:10px; padding:4px 8px; border-radius:6px; cursor:pointer;">
                      🗑️ Delete Campaign
                    </button>
                  </form>
                ` : ''}
              </div>
            `;
            listEl.appendChild(card);
          });
        }

        const modal = document.getElementById("brandModal");
        modal.style.display = "flex";
        setTimeout(() => {
          modal.style.opacity = "1";
          modal.querySelector(".brand-modal-card").style.transform = "scale(1)";
        }, 10);
      }

      function closeBrandModal() {
        const modal = document.getElementById("brandModal");
        modal.style.opacity = "0";
        modal.querySelector(".brand-modal-card").style.transform = "scale(0.95)";
        setTimeout(() => {
          modal.style.display = "none";
        }, 200);
      }

      const searchInput = document.getElementById("folderSearch");
      const clearBtn = document.getElementById("searchClearBtn");
      const kbd = document.getElementById("searchKbd");
      const feedback = document.getElementById("searchFeedback");
      const cards = document.querySelectorAll(".folder-card-wrap");

      function updateSearch() {
        const term = searchInput.value.toLowerCase().trim();
        let visibleCount = 0;

        cards.forEach((card) => {
          const name = card.getAttribute("data-name") || "";
          if (name.includes(term)) {
            card.style.display = "";
            visibleCount++;
          } else {
            card.style.display = "none";
          }
        });

        if (term) {
          clearBtn.style.display = "block";
          feedback.style.display = "block";
          feedback.textContent = `${visibleCount} found`;
        } else {
          clearBtn.style.display = "none";
          feedback.style.display = "none";
        }
      }

      if (searchInput) {
        searchInput.addEventListener("input", updateSearch);
        document.addEventListener("keydown", (e) => {
          if (e.key === "/" && document.activeElement !== searchInput) {
            e.preventDefault();
            searchInput.focus();
          }
        });
        if (clearBtn) {
          clearBtn.addEventListener("click", () => {
            searchInput.value = "";
            updateSearch();
            searchInput.focus();
          });
        }
      }
    </script>
  </body>
</html>
