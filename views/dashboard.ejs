      <script>
        document.addEventListener("DOMContentLoaded", () => {
          const typeToggle = document.getElementById('invoiceTypeToggle');
          const countPill = document.getElementById('invoiceCountPill');

          // 1. Restore saved state from localStorage on load
          if (typeToggle) {
            const savedToggleState = localStorage.getItem('dashboard_show_non_gst');
            if (savedToggleState !== null) {
              typeToggle.checked = (savedToggleState === 'true');
            }
          }

          function filterInvoices() {
            if (!typeToggle) return;
            const showNonGst = typeToggle.checked;
            const invoiceRows = document.querySelectorAll('#invoiceTableBody .context-row');
            let visibleCount = 0;

            invoiceRows.forEach(row => {
              const typeCell = row.querySelector('.type-cell');
              if (!typeCell) {
                row.style.removeProperty('display');
                visibleCount++;
                return;
              }
              const typeText = typeCell.textContent.trim().toLowerCase();
              const isNonGst = typeText.includes('non');

              let show = false;
              if (!showNonGst && !isNonGst) {
                show = true;
              } else if (showNonGst && isNonGst) {
                show = true;
              }

              if (show) {
                row.style.removeProperty('display');
                visibleCount++;
              } else {
                row.style.setProperty('display', 'none', 'important');
              }
            });

            if (countPill) {
              countPill.textContent = `${visibleCount} item${visibleCount !== 1 ? 's' : ''}`;
            }
          }

          const labelGst = document.getElementById('labelGst');
          const labelNonGst = document.getElementById('labelNonGst');

          if (labelGst && typeToggle) {
            labelGst.addEventListener('click', () => {
              if (typeToggle.checked) {
                typeToggle.checked = false;
                localStorage.setItem('dashboard_show_non_gst', 'false');
                filterInvoices();
              }
            });
          }

          if (labelNonGst && typeToggle) {
            labelNonGst.addEventListener('click', () => {
              if (!typeToggle.checked) {
                typeToggle.checked = true;
                localStorage.setItem('dashboard_show_non_gst', 'true');
                filterInvoices();
              }
            });
          }

          if (typeToggle) {
            typeToggle.addEventListener('change', () => {
              localStorage.setItem('dashboard_show_non_gst', typeToggle.checked ? 'true' : 'false');
              filterInvoices();
            });
            filterInvoices();
          }

          // Make the entire 3D switch lever container clickable (improves mobile touch responsiveness)
          const toggleContainer = document.querySelector('.toggle-container');
          if (toggleContainer && typeToggle) {
            toggleContainer.addEventListener('click', (e) => {
              if (e.target !== typeToggle) {
                typeToggle.checked = !typeToggle.checked;
                typeToggle.dispatchEvent(new Event('change'));
              }
            });
          }

          // Helper to format Indian currency
          function formatInr(val) {
            return Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          }

          // Helper to calculate invoice total payout matching EJS gstBreakup
          function gstBreakup(inv) {
            const isGst = inv.invoice_type === 'gst';
            const taxable = Number(inv.taxable_amount ?? inv.locked_amount ?? inv.total_amount ?? 0);
            const cgst = Number(inv.cgst_amount ?? (taxable * 0.09).toFixed(2));
            const sgst = Number(inv.sgst_amount ?? (taxable * 0.09).toFixed(2));
            const gst = Number(inv.gst_amount ?? (cgst + sgst).toFixed(2));
            return Number(inv.final_amount ?? (isGst ? (taxable + gst) : inv.total_amount ?? taxable));
          }

          // ═══════════════════════════════════════
          //   LIVE SYNC POLLING SYSTEM
          // ═══════════════════════════════════════
          let currentStateHash = '';

          function computeHash(data) {
            const invHash = data.invoices.map(i => `${i.id}-${i.status}-${i.invoice_type}-${i.total_amount}`).join('|');
            const noteHash = (data.notifications || []).map(n => `${n.id}-${n.is_read}`).join('|');
            return `${invHash}#${noteHash}`;
          }

          function pollData() {
            fetch('/admin/api/invoices')
              .then(res => res.ok ? res.json() : null)
              .then(data => {
                if (!data) return;
                const newHash = computeHash(data);
                if (newHash !== currentStateHash) {
                  currentStateHash = newHash;
                  updateDashboardUI(data);
                }
              })
              .then(null, e => {
                console.error("Live sync check failed:", e);
              });
          }

          window.pollData = pollData;

          function updateDashboardUI(data) {
            // 1. Update stats count
            const statTotalInvoices = document.getElementById('statTotalInvoices');
            const statPendingReview = document.getElementById('statPendingReview');
            const statTotalPayout = document.getElementById('statTotalPayout');

            if (statTotalInvoices) statTotalInvoices.textContent = data.invoices.length;

            if (statPendingReview) {
              const pendingCount = data.invoices.filter(i => i.status === 'SUBMITTED' || i.status === 'REGENERATED').length;
              statPendingReview.textContent = pendingCount;
            }

            if (statTotalPayout) {
              const totalPayout = data.invoices.reduce((sum, i) => sum + gstBreakup(i), 0);
              statTotalPayout.textContent = '₹' + Math.round(totalPayout).toLocaleString('en-IN');
            }

            // 2. Update Invoices table body
            const tableBody = document.getElementById('invoiceTableBody');
            if (tableBody) {
              if (data.invoices.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: #6b7280; padding: 30px;">No invoices yet.</td></tr>';
              } else {
                tableBody.innerHTML = data.invoices.map((inv, idx) => {
                  const isGstStr = inv.invoice_type === 'gst' ? 'GST' : 'Non-GST';
                  const finalAmt = gstBreakup(inv);
                  const pdfBtn = inv.pdf_path
                    ? '<a href="' + inv.pdf_path + '" target="_blank" class="btn btn-3d-sm btn-3d-open">Download PDF</a>'
                    : '';

                  const utrSpan = inv.utr ? '<br/><span class="utr-copy-badge" onclick="copyUtrToClipboard(\'' + inv.utr + '\', this)" style="font-size: 10px; font-weight: 800; color: #059669; background: rgba(16, 185, 129, 0.12); padding: 2px 8px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px; margin-top: 4px; border: 1px solid rgba(16, 185, 129, 0.3); cursor: pointer; transition: all 0.2s ease;" title="Click to copy UTR: ' + inv.utr + '">✨ UTR: ' + inv.utr + ' <span style="font-size: 11px; opacity: 0.8;">📋</span></span>' : '';

                  return '<tr class="context-row">' +
                    '<td style="color: #6B7280; font-weight: 600;" data-label="ID">#' + (idx + 1) + '</td>' +
                    '<td class="campaign-cell" data-label="Campaign"><strong>' + (inv.campaign_name || '') + '</strong><br/><span style="font-size: 11px; color: #64748b;">' + (inv.campaign_code || '') + '</span></td>' +
                    '<td data-label="Team Name"><strong style="color: #7c3aed; font-size: 13px;">' + (inv.team_name || '—') + '</strong><br/><span style="font-size: 11px; color: #64748b; font-weight: 600;">Head: ' + (inv.head_username || '—') + '</span></td>' +
                    '<td data-label="Creator"><strong data-creator-hover="' + (inv.creator_name || '') + '" style="cursor: pointer;">' + (inv.creator_name || '') + '</strong><br/><span style="color: #6B7280; font-size: 12px;">' + (inv.creator_mobile || '') + '</span>' + utrSpan + '</td>' +
                    '<td style="font-weight: 500; color: #4B5563;" data-label="Invoice No">#' + (inv.invoice_no || '') + '</td>' +
                    '<td class="type-cell" data-label="Type"><span>' + isGstStr + '</span></td>' +
                    '<td class="total-cell" data-label="Total Amount">₹' + formatInr(finalAmt) + '</td>' +
                    '<td data-label="Status"><span class="status-pill ' + inv.status + '">' + inv.status + '</span></td>' +
                    '<td class="action-cell" data-label="Action"><a href="/admin/invoices/' + inv.id + '" class="btn btn-3d-sm btn-3d-open">Open</a><div class="row-hover-overlay"><a href="/admin/invoices/' + inv.id + '" class="btn btn-3d-sm btn-3d-view">View Details</a>' + pdfBtn + '</div></td>' +
                  '</tr>';
                }).join('');
              }
            }

            // 3. Update Notification Drawer
            const bellCount = document.getElementById('bellCount');
            const drawerBody = document.getElementById('drawerBody');

            if (bellCount) {
              if (data.notifications && data.notifications.length > 0) {
                bellCount.textContent = data.notifications.length;
                bellCount.style.display = '';
              } else {
                bellCount.style.display = 'none';
              }
            }

            if (drawerBody) {
              if (!data.notifications || data.notifications.length === 0) {
                drawerBody.innerHTML = '<div class="empty-state">All caught up! No pending notifications.</div>';
              } else {
                drawerBody.innerHTML = data.notifications.map(note => {
                  const actionBlock = note.invoice_id
                    ? '<a href="/admin/invoices/' + note.invoice_id + '" class="btn btn-3d-sm btn-3d-open">Open</a>' +
                      '<form method="post" action="/admin/invoices/' + note.invoice_id + '/status" style="display: inline;"><input type="hidden" name="action" value="accept" /><button type="submit" class="btn btn-3d-sm btn-3d-accept">Accept</button></form>' +
                      '<form method="post" action="/admin/invoices/' + note.invoice_id + '/status" style="display: inline;" onsubmit="return handleDashboardReject(event, this)"><input type="hidden" name="action" value="reject" /><button type="submit" class="btn btn-3d-sm btn-3d-reject">Reject</button></form>'
                    : '';

                  return '<div class="drawer-card">' +
                    '<div class="drawer-card-header"><span class="eyebrow">' + (note.campaign_name || 'Campaign') + '</span><span class="pill status-pill ' + note.invoice_status + '" style="font-size: 10px;">' + note.invoice_status + '</span></div>' +
                    '<p class="drawer-message">' + note.message + '</p>' +
                    '<div class="drawer-actions">' + actionBlock + '</div>' +
                  '</div>';
                }).join('');
              }
            }

            // 4. Re-run local filters to keep the active toggle view synced
            filterInvoices();
          }

          // Initialize state hash
          const initialInvoices = [];
          document.querySelectorAll('#invoiceTableBody .context-row').forEach(row => {
            const cells = row.querySelectorAll('td');
            if (cells.length < 5) return;
            const id = cells[0] ? cells[0].textContent.replace('#', '').trim() : '';
            const campStrong = row.querySelector('.campaign-cell strong');
            const campSpan = row.querySelector('.campaign-cell span');
            const creatorStrong = cells[2] ? cells[2].querySelector('strong') : null;
            const creatorSpan = cells[2] ? cells[2].querySelector('span') : null;
            const statusPill = row.querySelector('.status-pill');
            const typeSpan = row.querySelector('.type-cell span');

            const campaignName = campStrong ? campStrong.textContent.trim() : '';
            const campaignCode = campSpan ? campSpan.textContent.trim() : '';
            const creatorName = creatorStrong ? creatorStrong.textContent.trim() : (cells[2] ? cells[2].textContent.trim() : '');
            const creatorMobile = creatorSpan ? creatorSpan.textContent.trim() : '';
            const invoiceNo = cells[3] ? cells[3].textContent.replace('#', '').trim() : '';
            const type = typeSpan && typeSpan.textContent.trim().toLowerCase() === 'gst' ? 'gst' : 'non_gst';
            const status = statusPill ? statusPill.textContent.trim() : '';
            initialInvoices.push({ id, status, invoice_type: type, total_amount: 0 });
          });

          const initialNotifications = [];
          const drawerBody = document.getElementById('drawerBody');
          if (drawerBody) {
            drawerBody.querySelectorAll('.drawer-card').forEach(card => {
              initialNotifications.push({ id: 1, is_read: 0 });
            });
          }

          currentStateHash = computeHash({ invoices: initialInvoices, notifications: initialNotifications });

          // Start polling every 5 seconds
          setInterval(pollData, 5000);
        });

        function handleDashboardReject(event, form) {
          event.preventDefault();
          const reason = prompt("Invoice Rejection Reason (COMPULSORY):");
          if (!reason || !reason.trim()) {
            alert("Invoice rejection cancelled. A Rejection Reason is compulsory!");
            return false;
          }
          let reasonInput = form.querySelector('input[name="reason"]');
          if (!reasonInput) {
            reasonInput = document.createElement('input');
            reasonInput.type = 'hidden';
            reasonInput.name = 'reason';
            form.appendChild(reasonInput);
          }
          reasonInput.value = reason.trim();
          form.submit();
          return true;
        }

        function copyUtrToClipboard(utrText, element) {
          if (!utrText) return;
          const origHtml = element.innerHTML;
          navigator.clipboard.writeText(utrText).then(() => {
            element.innerHTML = '✓ Copied!';
            element.style.background = '#d1fae5';
            element.style.borderColor = '#10b981';
            element.style.color = '#047857';
            setTimeout(() => {
              element.innerHTML = origHtml;
              element.style.background = '';
              element.style.borderColor = '';
              element.style.color = '';
            }, 1800);
          }).catch(() => {
            const el = document.createElement('textarea');
            el.value = utrText;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
            element.innerHTML = '✓ Copied!';
            setTimeout(() => { element.innerHTML = origHtml; }, 1800);
          });
        }
      </script>
    </div>
  </div>
</body>

</html>