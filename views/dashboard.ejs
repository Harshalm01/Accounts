<!doctype html>
<html>

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dashboard</title>
  <link rel="stylesheet" href="/public/styles.css?v=45" />
  <style>
    .creator-search-box-wrap {
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      width: 280px;
      margin: 6px 0 14px 0;
    }

    .creator-search-box-wrap:focus-within,
    .creator-search-box-wrap.is-expanded {
      width: 100%;
      max-width: 480px;
    }

    .animated-search-container {
      display: flex;
      align-items: center;
      background: #ffffff;
      border: 2px solid #e2e8f0;
      border-radius: 50px;
      padding: 4px 6px 4px 14px;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
      transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
    }

    .animated-search-container:focus-within {
      border-color: #7c3aed;
      box-shadow: 0 8px 25px rgba(124, 58, 237, 0.25), 0 0 0 4px rgba(124, 58, 237, 0.12);
      transform: translateY(-2px);
    }

    .search-icon-spin {
      font-size: 16px;
      margin-right: 8px;
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      display: inline-block;
    }

    .animated-search-container:focus-within .search-icon-spin {
      transform: rotate(360deg) scale(1.15);
    }

    .animated-search-input {
      flex: 1;
      border: none !important;
      background: transparent !important;
      color: #0f172a !important;
      font-weight: 700 !important;
      font-size: 14px !important;
      outline: none !important;
      box-shadow: none !important;
      padding: 8px 0 !important;
      font-family: inherit;
    }

    .animated-search-input::placeholder {
      color: #94a3b8 !important;
      font-weight: 500 !important;
    }

    .kbd-shortcut-hint {
      font-size: 10px;
      font-weight: 800;
      color: #94a3b8;
      background: #f1f5f9;
      padding: 2px 7px;
      border-radius: 6px;
      margin-right: 6px;
      transition: all 0.2s ease;
      user-select: none;
    }

    .animated-search-container:focus-within .kbd-shortcut-hint {
      color: #7c3aed;
      background: #f3e8ff;
    }

    .animated-search-btn {
      background: linear-gradient(135deg, #7c3aed 0%, #4f46e5 100%) !important;
      color: #ffffff !important;
      border: none !important;
      border-radius: 40px !important;
      padding: 10px 18px !important;
      font-weight: 800 !important;
      font-size: 12px !important;
      letter-spacing: 0.5px !important;
      text-transform: uppercase !important;
      cursor: pointer !important;
      transition: all 0.25s ease-in-out !important;
      box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3) !important;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .animated-search-btn:hover {
      background: linear-gradient(135deg, #6d28d9 0%, #3730a3 100%) !important;
      box-shadow: 0 6px 20px rgba(124, 58, 237, 0.45) !important;
      transform: scale(1.05);
    }

    .animated-search-btn:active {
      transform: scale(0.95);
    }
  </style>
</head>

<body class="admin-page">
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <div class="main-content-wrapper">
      <% function gstBreakup(inv) { %>
        <% const isGst=inv.invoice_type==='gst' ; %>
          <% const taxable=Number(inv.taxable_amount ?? inv.locked_amount ?? inv.total_amount ?? 0); %>
            <% const cgst=Number(inv.cgst_amount ?? (taxable * 0.09).toFixed(2)); %>
              <% const sgst=Number(inv.sgst_amount ?? (taxable * 0.09).toFixed(2)); %>
                <% const gst=Number(inv.gst_amount ?? (cgst + sgst).toFixed(2)); %>
                  <% return Number(inv.final_amount ?? (isGst ? (taxable + gst) : inv.total_amount ?? taxable)); %>
                    <% } %>
                      <div class="topbar hero-banner folder-header-banner" style="margin-bottom: 24px;">
                        <div class="header-left">
                          <div class="eyebrow">Portal overview</div>
                          <h2 style="margin: 8px 0 6px 0;">Dashboard</h2>
                          <div class="pill">
                            <%= user.role %> • <%= user.username %>
                          </div>
                        </div>

                        <div class="header-right">
                          <div class="header-actions-row">
                            <% if (user.role==='ACCOUNTS' || user.role==='SUPER_ADMIN' ) { %>
                              <button type="button" class="btn btn-3d-nav btn-3d-bell" id="bellBtn">
                                🔔
                                <% if (notifications.length> 0) { %>
                                  <span class="bell-badge" id="bellCount">
                                    <%= notifications.length %>
                                  </span>
                                  <% } %>
                              </button>
                              <% } %>
                          </div>

                          <div class="header-stats-grid">
                            <div class="header-stat-card">
                              <span class="stat-icon">📄</span>
                              <div class="stat-info">
                                <span class="stat-value">
                                  <%= invoices.length %>
                                </span>
                                <span class="stat-label">Total Invoices</span>
                              </div>
                            </div>

                            <div class="header-stat-card">
                              <span class="stat-icon">⏳</span>
                              <div class="stat-info">
                                <% let pendingCount=invoices.filter(i=> i.status === 'SUBMITTED' || i.status ===
                                  'REGENERATED').length; %>
                                  <span class="stat-value">
                                    <%= pendingCount %>
                                  </span>
                                  <span class="stat-label">Pending Review</span>
                              </div>
                            </div>

                            <div class="header-stat-card">
                              <span class="stat-icon">💰</span>
                              <div class="stat-info">
                                <% let totalPayout=invoices.reduce((sum, i)=> sum + gstBreakup(i), 0);
                                  %>
                                  <span class="stat-value">₹<%= Math.round(totalPayout).toLocaleString('en-IN') %></span>
                                  <span class="stat-label">Total Payout</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>

                      <% if (typeof utrSuccess !== 'undefined' && utrSuccess) { %>
                        <div class="alert alert-success" style="margin-bottom: 16px; background: rgba(16, 185, 129, 0.15); color: #10B981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 12px 16px; border-radius: 10px; font-weight: 600; font-size: 14px;">
                          ✅ <%= utrSuccess %>
                        </div>
                      <% } %>
                      <% if (typeof utrError !== 'undefined' && utrError) { %>
                        <div class="alert alert-error" style="margin-bottom: 16px; background: rgba(239, 68, 68, 0.15); color: #EF4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 12px 16px; border-radius: 10px; font-weight: 600; font-size: 14px;">
                          ⚠️ <%= utrError %>
                        </div>
                      <% } %>

                    <% if (user.role==='ACCOUNTS' || user.role==='SUPER_ADMIN' ) { %>
                      <!-- Accounts UTR Settlement Card -->
                      <div class="card glass-panel" style="margin-bottom: 20px;">
                        <div class="section-head" style="margin-bottom: 0;">
                          <div>
                            <div class="eyebrow" style="color: #059669 !important; font-weight: 700; text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em; margin-bottom: 2px;">
                              Accounts Station
                            </div>
                            <h3 style="margin: 0; font-size: 18px; font-weight: 800; color: #1e293b;">UTR Payment Settlement</h3>
                            <p class="subtitle" style="margin-top: 4px; color: #64748b !important;">
                              Download formatted Excel templates or bulk upload creator payment UTR details.
                            </p>
                          </div>
                          <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                            <a href="/admin/utr-template/download" download="UTR_Payment_Format.xlsx" class="btn btn-3d-nav" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                              📥 Download Format
                            </a>
                            <button type="button" class="btn btn-3d-nav" onclick="openUtrModal()" style="display: inline-flex; align-items: center; gap: 6px; background: linear-gradient(135deg, #10B981 0%, #059669 100%); color: white; border: none;">
                              📤 Upload UTR Excel
                            </button>
                          </div>
                        </div>
                      </div>

                      <!-- UTR Upload Modal -->
                      <div id="utrUploadModal" class="modal-overlay" style="display: none; opacity: 0; transition: opacity 0.25s ease;">
                        <div class="modal-card" style="position: relative;">
                          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                            <div>
                              <h3 style="font-size: 20px; font-weight: 800; color: #0f172a; margin: 0;">Upload UTR Payment Batch</h3>
                              <p class="subtitle" style="margin-top: 4px; font-size: 14px; color: #64748b;">
                                Upload an Excel (.xlsx, .xls) or CSV file to update creator payment UTRs.
                              </p>
                            </div>
                            <button onclick="closeUtrModal()" style="background: none; border: none; font-size: 24px; color: #94a3b8; cursor: pointer; line-height: 1; transition: color 0.2s;" onmouseover="this.style.color='#0f172a'" onmouseout="this.style.color='#94a3b8'">&times;</button>
                          </div>

                          <!-- Required Headers Info Box -->
                          <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 14px; padding: 14px 16px; margin-bottom: 20px;">
                            <div style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px; margin-bottom: 8px;">
                              Required Column Headers:
                            </div>
                            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                              <span style="background: #ffffff; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700; color: #334155; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">Phone Number</span>
                              <span style="background: #ffffff; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700; color: #334155; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">Campaign Name</span>
                              <span style="background: #ffffff; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700; color: #334155; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">Creator Name</span>
                              <span style="background: #ffffff; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700; color: #334155; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">Amount</span>
                              <span style="background: #ecfdf5; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 800; color: #059669; border: 1px solid #a7f3d0; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">✨ UTR</span>
                            </div>
                          </div>

                          <!-- Upload Form with Drag & Drop Area -->
                          <form method="post" action="/admin/upload-utr" enctype="multipart/form-data" id="utrUploadForm">
                            <div id="dropZone" style="border: 2px dashed #cbd5e1; background: #f8fafc; border-radius: 16px; padding: 28px 20px; text-align: center; cursor: pointer; transition: all 0.25s ease-in-out; margin-bottom: 20px;" onclick="document.getElementById('utrFileInput').click()">
                              <input type="file" id="utrFileInput" name="utrFile" accept=".xlsx,.xls,.csv" required style="display: none;" onchange="handleUtrFileSelect(this)" />
                              
                              <div id="dropZonePrompt">
                                <div style="font-size: 32px; margin-bottom: 8px;">📂</div>
                                <div style="font-size: 14px; font-weight: 700; color: #334155; margin-bottom: 4px;">
                                  Drag & Drop your file here
                                </div>
                                <div style="font-size: 12px; color: #64748b; font-weight: 500;">
                                  or <span style="color: #7c3aed; font-weight: 700; text-decoration: underline;">click to browse files</span>
                                </div>
                              </div>

                              <div id="filePreview" style="display: none; align-items: center; justify-content: space-between; background: #ffffff; border: 1px solid #10b981; padding: 12px 16px; border-radius: 12px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.1);">
                                <div style="display: flex; align-items: center; gap: 10px; text-align: left; overflow: hidden;">
                                  <span style="font-size: 24px;">📊</span>
                                  <div>
                                    <div id="fileNameDisplay" style="font-size: 13px; font-weight: 700; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 320px;"></div>
                                    <div id="fileSizeDisplay" style="font-size: 11px; color: #059669; font-weight: 600;"></div>
                                  </div>
                                </div>
                                <button type="button" onclick="event.stopPropagation(); clearUtrFileSelection();" style="background: #fef2f2; border: 1px solid #fecaca; color: #ef4444; border-radius: 8px; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 14px;">✕</button>
                              </div>
                            </div>

                            <div style="display: flex; justify-content: space-between; align-items: center;">
                              <a href="/admin/utr-template/download" download="UTR_Payment_Format.xlsx" style="font-size: 13px; font-weight: 700; color: #7c3aed; text-decoration: none; display: flex; align-items: center; gap: 4px;">
                                📥 Download Sample Format
                              </a>
                              <div style="display: flex; gap: 10px;">
                                <button type="button" onclick="closeUtrModal()" class="btn btn-3d-nav" style="padding: 10px 18px; background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; font-weight: 700;">Cancel</button>
                                <button type="submit" id="utrSubmitBtn" class="btn btn-3d-nav" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%); color: white; border: none; font-weight: 800; padding: 10px 22px;">Upload & Update</button>
                              </div>
                            </div>
                          </form>
                        </div>
                      </div>

                      <script>
                        function openUtrModal() {
                          const modal = document.getElementById('utrUploadModal');
                          modal.style.display = 'flex';
                          setTimeout(() => {
                            modal.style.opacity = '1';
                            const card = modal.querySelector('.modal-card');
                            if (card) card.style.transform = 'scale(1)';
                          }, 10);
                        }

                        function closeUtrModal() {
                          const modal = document.getElementById('utrUploadModal');
                          modal.style.opacity = '0';
                          const card = modal.querySelector('.modal-card');
                          if (card) card.style.transform = 'scale(0.9)';
                          setTimeout(() => {
                            modal.style.display = 'none';
                            clearUtrFileSelection();
                          }, 250);
                        }

                        function handleUtrFileSelect(input) {
                          if (input.files && input.files[0]) {
                            const file = input.files[0];
                            document.getElementById('fileNameDisplay').innerText = file.name;
                            document.getElementById('fileSizeDisplay').innerText = (file.size / 1024).toFixed(1) + ' KB';
                            document.getElementById('dropZonePrompt').style.display = 'none';
                            document.getElementById('filePreview').style.display = 'flex';
                          }
                        }

                        function clearUtrFileSelection() {
                          const input = document.getElementById('utrFileInput');
                          if (input) input.value = '';
                          document.getElementById('dropZonePrompt').style.display = 'block';
                          document.getElementById('filePreview').style.display = 'none';
                        }

                        document.addEventListener("DOMContentLoaded", () => {
                          const dropZone = document.getElementById('dropZone');
                          if (!dropZone) return;

                          ['dragenter', 'dragover'].forEach(eventName => {
                            dropZone.addEventListener(eventName, (e) => {
                              e.preventDefault();
                              e.stopPropagation();
                              dropZone.style.borderColor = '#10b981';
                              dropZone.style.background = '#ecfdf5';
                            }, false);
                          });

                          ['dragleave', 'drop'].forEach(eventName => {
                            dropZone.addEventListener(eventName, (e) => {
                              e.preventDefault();
                              e.stopPropagation();
                              dropZone.style.borderColor = '#cbd5e1';
                              dropZone.style.background = '#f8fafc';
                            }, false);
                          });

                          dropZone.addEventListener('drop', (e) => {
                            const dt = e.dataTransfer;
                            const files = dt.files;
                            if (files && files.length > 0) {
                              const input = document.getElementById('utrFileInput');
                              input.files = files;
                              handleUtrFileSelect(input);
                            }
                          }, false);
                        });
                      </script>
                    <% } %>

                    <!-- SuperAdmin Compact Creator Search Engine -->
                    <% if (user.role==='SUPER_ADMIN' ) { %>
                      <div class="card glass-panel" style="margin-bottom: 20px; padding: 22px 28px;">
                        <div
                          style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;">
                          <div>
                            <span
                              style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: #7c3aed; letter-spacing: 1px;">👑
                              SuperAdmin Search Engine</span>
                            <h3 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 2px 0 0 0;">Search
                              Creator Ledger</h3>
                          </div>
                          <span class="pill" id="superAdminSearchResultCount"
                            style="display: none; background: #f3e8ff; color: #7c3aed; font-weight: 800; font-size: 11px;">
                            0 records found
                          </span>
                        </div>

                        <!-- Compact Animated Expanding Search Bar -->
                        <div class="creator-search-box-wrap" id="searchBoxWrap">
                          <div class="animated-search-container">
                            <span class="search-icon-spin">🔍</span>
                            <input type="text" class="animated-search-input" id="superAdminCreatorInput"
                              placeholder="Search Creator (e.g. Harshal)..."
                              oninput="executeSuperAdminCreatorSearch()"
                              onkeyup="if(event.key==='Enter') executeSuperAdminCreatorSearch()" />
                            <span class="kbd-shortcut-hint">↵ Enter</span>
                            <button type="button" class="animated-search-btn"
                              onclick="executeSuperAdminCreatorSearch()">
                              SEARCH
                            </button>
                          </div>
                        </div>

                        <!-- HIDDEN RESULTS TABLE (ONLY DISPLAYED AFTER SEARCHING) -->
                        <div id="superAdminSearchResultsContainer"
                          style="display: none; margin-top: 16px; border-top: 1px dashed #cbd5e1; padding-top: 16px;">
                          <div class="users-table-wrap">
                            <table class="users-table">
                              <thead>
                                <tr>
                                  <th>Creator Name</th>
                                  <th>Campaign Name</th>
                                  <th>Team Name</th>
                                  <th>Invoice Amount (₹)</th>
                                  <th>Campaign Date & Year</th>
                                  <th>Status</th>
                                  <th>Action</th>
                                </tr>
                              </thead>
                              <tbody id="superAdminCreatorLedgerBody">
                                <% const combinedRows=[]; const addedKeys=new Set(); if (typeof invoices !=='undefined'
                                  && invoices && invoices.length) { invoices.forEach(inv=> {
                                  const key = (inv.id || '') + '-' + (inv.creator_name || '');
                                  addedKeys.add(key);
                                  combinedRows.push({
                                  invoice_id: inv.id,
                                  creator_name: inv.creator_name,
                                  creator_mobile: inv.creator_mobile,
                                  invoice_no: inv.invoice_no,
                                  invoice_date: inv.invoice_date || inv.created_at,
                                  final_amount: inv.final_amount || inv.total_amount,
                                  invoice_status: inv.status,
                                  campaign_name: inv.campaign_name,
                                  campaign_code: inv.campaign_code,
                                  team_name: inv.team_name,
                                  head_username: inv.head_username,
                                  campaign_created_at: inv.created_at
                                  });
                                  });
                                  }

                                  if (typeof creatorLedger !== 'undefined' && creatorLedger && creatorLedger.length) {
                                  creatorLedger.forEach(row => {
                                  const key = (row.invoice_id || '') + '-' + (row.creator_name || '');
                                  if (!addedKeys.has(key)) {
                                  addedKeys.add(key);
                                  combinedRows.push(row);
                                  }
                                  });
                                  }
                                  %>
                                  <% if (combinedRows.length) { %>
                                    <% combinedRows.forEach((row)=> { %>
                                      <% const rawDate=row.campaign_created_at || row.invoice_date || Date.now(); const
                                        d=new Date(rawDate); const formattedDate=!isNaN(d.getTime()) ?
                                        d.toLocaleDateString('en-IN', { day: '2-digit' , month: 'short' ,
                                        year: 'numeric' }) : 'N/A' ; const yearStr=!isNaN(d.getTime()) ? d.getFullYear()
                                        : 'N/A' ; const displayAmount=row.final_amount || row.total_amount || 0; const
                                        searchToken=((row.creator_name || '' ) + ' ' + (row.campaign_name || '' ) + ' '
                                        + (row.team_name || '') + ' ' + (row.head_username || '') + ' '
                                        + yearStr + ' ' + (row.creator_mobile || '' ) + ' ' + (row.invoice_no || ''
                                        )).toLowerCase(); %>
                                        <tr class="sa-creator-row" data-search="<%= searchToken %>">
                                          <td data-label="Creator Name">
                                            <strong style="color: #0f172a; font-size: 14px;">
                                              <%= row.creator_name %>
                                            </strong><br />
                                            <span style="font-size: 11px; color: #64748b;">
                                              <%= row.creator_mobile || 'No Mobile' %>
                                            </span>
                                          </td>
                                          <td data-label="Campaign Name">
                                            <strong style="color: #1e293b; font-size: 13px;">
                                              <%= row.campaign_name || 'Campaign' %>
                                            </strong><br />
                                            <span class="pill"
                                              style="font-size: 10px; background: #f1f5f9; color: #475569; padding: 2px 8px;">
                                              <%= row.campaign_code || 'N/A' %>
                                            </span>
                                          </td>
                                          <td data-label="Team Name">
                                             <strong style="color: #7c3aed; font-size: 13px;">
                                               <%= row.team_name || '—' %>
                                             </strong><br />
                                             <span style="font-size: 11px; color: #64748b; font-weight: 600;">
                                               Head: <%= row.head_username || '—' %>
                                             </span>
                                           </td>
                                          <td data-label="Invoice Amount">
                                            <span
                                              style="font-weight: 800; font-family: monospace; color: #0f172a; font-size: 14px;">
                                              ₹<%= Number(displayAmount).toLocaleString('en-IN', {
                                                minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                            </span>
                                          </td>
                                          <td data-label="Campaign Date & Year">
                                            <div style="font-weight: 700; color: #334155; font-size: 13px;">
                                              <%= formattedDate %>
                                            </div>
                                            <span
                                              style="font-size: 11px; font-weight: 800; color: #7c3aed; background: #f3e8ff; padding: 2px 8px; border-radius: 4px; display: inline-block; margin-top: 2px;">
                                              Year <%= yearStr %>
                                            </span>
                                          </td>
                                          <td data-label="Status">
                                            <span class="status-pill <%= row.invoice_status %>"
                                              style="font-size: 11px; font-weight: 700;">
                                              <%= row.invoice_status %>
                                            </span>
                                          </td>
                                          <td data-label="Action">
                                            <% if (row.invoice_id) { %>
                                              <a href="/admin/invoices/<%= row.invoice_id %>"
                                                class="btn btn-3d-sm btn-3d-open"
                                                style="padding: 6px 14px; font-size: 12px;">👁️ View Invoice</a>
                                              <% } else { %>
                                                <span style="font-size: 11px; color: #94a3b8; font-weight: 600;">No
                                                  Invoice Yet</span>
                                                <% } %>
                                          </td>
                                        </tr>
