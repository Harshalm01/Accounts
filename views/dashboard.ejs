          // Mark all notifications as read in the background
          fetch("/admin/notifications/read", {
            method: "POST",
            headers: {
              "Content-Type": "application/x-www-form-urlencoded"
            }
          }).then(null, err => console.error("Error marking notifications as read:", err));
        });

        const closeDrawer = () => {
