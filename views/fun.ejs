  <script>
    // GLOBAL HUB & NAVIGATION STATE
    let currentSelectedTarget = null;

    function showGamesHub() {
      currentSelectedTarget = null;
      document.getElementById('gamesHubSection').style.display = 'block';
      document.getElementById('photoboothSection').style.display = 'none';
      document.getElementById('spaceRunnerSection').style.display = 'none';
      document.getElementById('dinoJumpSection').style.display = 'none';
      document.getElementById('galleryContainerSection').style.display = 'none';
      document.getElementById('backToHubWrap').style.display = 'none';
    }

    function openInstructionsModal(targetGame) {
      currentSelectedTarget = targetGame;
      const modal = document.getElementById('instructionsModal');
      const iconElem = document.getElementById('modalHeaderIcon');
      const titleElem = document.getElementById('modalHeaderTitle');
      const contentElem = document.getElementById('modalInstructionsContent');

      if (targetGame === 'photobooth') {
        iconElem.innerText = '📸';
        titleElem.innerText = 'How to Use 3FM Photobooth';
        contentElem.innerHTML = `
          <div class="instruction-step-item">
            <div class="instruction-step-icon">🎥</div>
            <div class="instruction-step-text">
              <strong>Allow Camera Access:</strong> Make sure your browser has permission to access your webcam feed.
            </div>
          </div>
          <div class="instruction-step-item">
            <div class="instruction-step-icon">🎨</div>
            <div class="instruction-step-text">
              <strong>Customize Layout & Filters:</strong> Pick from 8 visual filters (Vintage Sepia, B&W, Cyber Neon) and 4 strip layout templates.
            </div>
          </div>
          <div class="instruction-step-item">
            <div class="instruction-step-icon">⚡</div>
            <div class="instruction-step-text">
              <strong>Press [SPACE] to Snap:</strong> Press spacebar or click the Leica shutter button to capture single photos or auto 3-snap sequence.
            </div>
          </div>
          <div class="instruction-step-item">
            <div class="instruction-step-icon">⬇️</div>
            <div class="instruction-step-text">
              <strong>Download & Share:</strong> Download your high-res PNG photo strip with compulsory 3FM logo watermark, copy to clipboard, or print!
            </div>
          </div>
        `;
      } else if (targetGame === 'space-runner') {
        iconElem.innerText = '🚀';
        titleElem.innerText = 'How to Play 3FM Space Runner';
        contentElem.innerHTML = `
          <div class="instruction-step-item">
            <div class="instruction-step-icon">🎮</div>
            <div class="instruction-step-text">
              <strong>Jetpack Controls:</strong> Press & hold <strong>[SPACEBAR]</strong>, <strong>[ARROW UP]</strong> or <strong>CLICK/TOUCH</strong> screen to thrust upwards.
            </div>
          </div>
          <div class="instruction-step-item">
            <div class="instruction-step-icon">🪙</div>
            <div class="instruction-step-text">
              <strong>Collect Golden Coins:</strong> Fly into golden 3FM coins to score <strong>+10 bonus points</strong> per coin.
            </div>
          </div>
          <div class="instruction-step-item">
            <div class="instruction-step-icon">🪐</div>
            <div class="instruction-step-text">
