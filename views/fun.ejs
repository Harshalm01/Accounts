    function closeInstructionsModal() {
      document.getElementById('instructionsModal').classList.remove('active');
    }

    function confirmLaunchGame() {
      closeInstructionsModal();
      if (!currentSelectedTarget) return;

      document.getElementById('gamesHubSection').style.display = 'none';
      document.getElementById('backToHubWrap').style.display = 'block';

      if (currentSelectedTarget === 'photobooth') {
        document.getElementById('photoboothSection').style.display = 'block';
        document.getElementById('galleryContainerSection').style.display = 'block';
        initCamera();
        renderStripCanvas();
      } else if (currentSelectedTarget === 'space-runner') {
        document.getElementById('spaceRunnerSection').style.display = 'block';
        initRunnerGame();
      } else if (currentSelectedTarget === 'dino-jump') {
        document.getElementById('dinoJumpSection').style.display = 'block';
        initDinoGame();
      }
    }

    // ================= 1. PHOTOBOOTH STUDIO CODE =================
    let capturedPhotos = [];
    let savedGalleryStrips = [];
    let pendingDeleteIdx = null;

    let currentFilter = 'normal';
    let currentLayout = 'vertical3';
    let currentBgTheme = 'midnight';
    let activeStickers = [];
    let isMirrored = true;
    let audioEnabled = true;
    let autoSequenceActive = false;

    const imageCache = new Map();

    function getLoadedImage(url) {
      return new Promise((resolve) => {
        if (imageCache.has(url)) return resolve(imageCache.get(url));
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.onload = () => { imageCache.set(url, img); resolve(img); };
        img.onerror = () => resolve(null);
        img.src = url;
      });
    }

    const videoElem = document.getElementById('webcamVideo');
    const canvas = document.getElementById('photoboothCanvas');
    const ctx = canvas.getContext('2d');
    const countdownOverlay = document.getElementById('countdownOverlay');
    const flashOverlay = document.getElementById('flashOverlay');
    const shutterAudio = document.getElementById('shutterAudio');
    const beepAudio = document.getElementById('beepAudio');
    const logoImg = document.getElementById('logoImg');

    async function initCamera() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { width: { ideal: 1280 }, height: { ideal: 960 }, facingMode: 'user' },
          audio: false
        });
        videoElem.srcObject = stream;
      } catch (err) {
        console.error("Camera Error:", err);
      }
    }

    function toggleMirror() {
      isMirrored = !isMirrored;
      if (isMirrored) videoElem.classList.remove('unmirrored');
      else videoElem.classList.add('unmirrored');
    }

    function toggleAudio() {
      audioEnabled = !audioEnabled;
      document.getElementById('audioBtn').innerHTML = audioEnabled ? '🔊 Sound On' : '🔇 Muted';
    }

    function setAspectRatio(ratio, btnElem) {
      const viewport = document.getElementById('camViewport');
      viewport.className = `camera-viewport-card ratio-${ratio}`;
      const parent = btnElem.parentElement;
      parent.querySelectorAll('.light-pill').forEach(b => b.classList.remove('active'));
      btnElem.classList.add('active');
    }

    function setFilter(filterName, btnElem) {
      currentFilter = filterName;
      videoElem.className = `camera-feed filter-${filterName} ${isMirrored ? '' : 'unmirrored'}`;
      const parent = btnElem.parentElement;
      parent.querySelectorAll('.light-pill').forEach(b => b.classList.remove('active'));
      btnElem.classList.add('active');
    }

    function setLayout(layout, btnElem) {
      currentLayout = layout;
      const parent = btnElem.parentElement;
      parent.querySelectorAll('.light-pill').forEach(b => b.classList.remove('active'));
      btnElem.classList.add('active');

      if (layout === 'vertical3') { canvas.width = 600; canvas.height = 1300; }
      else if (layout === 'vertical4') { canvas.width = 600; canvas.height = 1600; }
      else if (layout === 'grid2x2') { canvas.width = 900; canvas.height = 1200; }
      else if (layout === 'polaroid') { canvas.width = 750; canvas.height = 950; }

      renderStripCanvas();
    }

    function setBgTheme(theme, swatchElem) {
      currentBgTheme = theme;
      document.querySelectorAll('.color-swatch-item').forEach(s => s.classList.remove('active'));
      swatchElem.classList.add('active');
      renderStripCanvas();
    }

    function toggleSticker(emoji, pillElem) {
      const idx = activeStickers.indexOf(emoji);
      if (idx > -1) { activeStickers.splice(idx, 1); pillElem.classList.remove('active'); }
      else { activeStickers.push(emoji); pillElem.classList.add('active'); }
      renderStripCanvas();
    }

    function playBeep() { if (audioEnabled && beepAudio) { beepAudio.currentTime = 0; beepAudio.play().catch(() => {}); } }
    function playShutter() { if (audioEnabled && shutterAudio) { shutterAudio.currentTime = 0; shutterAudio.play().catch(() => {}); } }

    function captureSinglePhoto() {
      return new Promise((resolve) => {
        let count = 3;
        countdownOverlay.innerText = count;
        countdownOverlay.classList.add('active');
        playBeep();

        const timer = setInterval(async () => {
          count--;
          if (count > 0) {
            countdownOverlay.innerText = count;
            playBeep();
          } else {
            clearInterval(timer);
            countdownOverlay.classList.remove('active');
            
            flashOverlay.classList.add('trigger-flash');
            playShutter();
            setTimeout(() => flashOverlay.classList.remove('trigger-flash'), 350);

            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = videoElem.videoWidth || 640;
            tempCanvas.height = videoElem.videoHeight || 480;
            const tempCtx = tempCanvas.getContext('2d');

            if (isMirrored) {
              tempCtx.translate(tempCanvas.width, 0);
              tempCtx.scale(-1, 1);
            }

            if (currentFilter === 'sepia') tempCtx.filter = 'sepia(0.65) contrast(1.1) brightness(0.95)';
            else if (currentFilter === 'cyber') tempCtx.filter = 'hue-rotate(180deg) saturate(2.2) contrast(1.25)';
            else if (currentFilter === 'bw') tempCtx.filter = 'grayscale(1) contrast(1.3) brightness(1.05)';
            else if (currentFilter === 'warm') tempCtx.filter = 'sepia(0.3) saturate(1.5) contrast(1.05) hue-rotate(-10deg)';
            else if (currentFilter === 'grain') tempCtx.filter = 'contrast(1.35) brightness(0.9) saturate(1.15)';
            else if (currentFilter === 'pastel') tempCtx.filter = 'saturate(1.6) contrast(0.9) brightness(1.15) hue-rotate(15deg)';
            else if (currentFilter === 'noir') tempCtx.filter = 'grayscale(1) contrast(2) brightness(0.75)';
            else tempCtx.filter = 'none';

            tempCtx.drawImage(videoElem, 0, 0, tempCanvas.width, tempCanvas.height);
            
            const dataUrl = tempCanvas.toDataURL('image/png');
            capturedPhotos.push(dataUrl);

            await getLoadedImage(dataUrl);
            updateThumbnails();
            await renderStripCanvas();
            resolve();
          }
        }, 850);
      });
    }

    async function triggerAutoSequence() {
      if (autoSequenceActive) return;
      autoSequenceActive = true;
      capturedPhotos = [];
      updateThumbnails();

      const totalRequired = currentLayout === 'vertical4' ? 4 : (currentLayout === 'polaroid' ? 1 : 3);

      for (let i = 0; i < totalRequired; i++) {
        await captureSinglePhoto();
        if (i < totalRequired - 1) await new Promise(r => setTimeout(r, 1000));
      }
      autoSequenceActive = false;
    }

    function removePhoto(idx) { capturedPhotos.splice(idx, 1); updateThumbnails(); renderStripCanvas(); }
    function resetPhotos() { capturedPhotos = []; updateThumbnails(); renderStripCanvas(); }

    function updateThumbnails() {
      const maxAllowed = currentLayout === 'vertical4' ? 4 : (currentLayout === 'polaroid' ? 1 : 3);
      document.getElementById('capturedCountLabel').innerText = `Captured Snaps (${capturedPhotos.length} / ${maxAllowed})`;

      const row = document.getElementById('thumbsRow');
      if (capturedPhotos.length === 0) {
        row.innerHTML = `<div style="font-size: 12px; color: #94a3b8; padding: 10px 0; font-weight: 600;">No snaps taken yet. Click shutter to capture!</div>`;
        return;
      }

      row.innerHTML = capturedPhotos.map((url, i) => `
        <div class="thumb-card-item">
          <img src="${url}" class="thumb-card-img" />
          <button class="thumb-del-btn" onclick="removePhoto(${i})" title="Remove">✕</button>
        </div>
      `).join('');
    }

    let whiteLogoCanvas = null;
    function getWhiteLogoCanvas() {
      if (!logoImg.complete || logoImg.naturalWidth === 0) return null;
      if (whiteLogoCanvas) return whiteLogoCanvas;

      const c = document.createElement('canvas');
      c.width = logoImg.naturalWidth;
      c.height = logoImg.naturalHeight;
      const cCtx = c.getContext('2d');
      cCtx.drawImage(logoImg, 0, 0);

      const imgData = cCtx.getImageData(0, 0, c.width, c.height);
      const data = imgData.data;

      for (let i = 0; i < data.length; i += 4) {
        const r = data[i], g = data[i + 1], b = data[i + 2], a = data[i + 3];
        if (a > 15) {
          const isPurple = (b > 100 && g < 90 && r > 70) || (r > 120 && b > 120 && g < 90);
          if (!isPurple) { data[i] = 255; data[i + 1] = 255; data[i + 2] = 255; }
        }
      }
      cCtx.putImageData(imgData, 0, 0);
      whiteLogoCanvas = c;
      return whiteLogoCanvas;
    }

    async function renderStripCanvas() {
      const w = canvas.width, h = canvas.height;
      ctx.clearRect(0, 0, w, h);

      const loadedImages = await Promise.all(capturedPhotos.map(url => getLoadedImage(url)));

      if (currentBgTheme === 'royal') { ctx.fillStyle = '#7c3aed'; }
      else if (currentBgTheme === 'cyber') { ctx.fillStyle = '#0284c7'; }
      else if (currentBgTheme === 'pastel') { ctx.fillStyle = '#f472b6'; }
      else if (currentBgTheme === 'sepia') { ctx.fillStyle = '#fef3c7'; }
      else if (currentBgTheme === 'white') { ctx.fillStyle = '#ffffff'; }
      else if (currentBgTheme === 'holographic') { ctx.fillStyle = '#cbd5e1'; }
      else if (currentBgTheme === 'dark') { ctx.fillStyle = '#000000'; }
      else { ctx.fillStyle = '#0f172a'; }

      ctx.fillRect(0, 0, w, h);

      ctx.strokeStyle = (currentBgTheme === 'white' || currentBgTheme === 'sepia') ? '#cbd5e1' : 'rgba(255,255,255,0.15)';
      ctx.lineWidth = 12;
      ctx.strokeRect(6, 6, w - 12, h - 12);

      const padding = 36;
      const headerSpace = 110;
      const footerSpace = 200;
      const availableHeight = h - headerSpace - footerSpace;

      if (currentLayout === 'vertical3' || currentLayout === 'vertical4') {
        const numSlots = currentLayout === 'vertical4' ? 4 : 3;
        const photoGap = 20;
        const photoWidth = w - (padding * 2);
        const photoHeight = (availableHeight - (photoGap * (numSlots - 1))) / numSlots;

        for (let i = 0; i < numSlots; i++) {
          const x = padding;
          const y = headerSpace + i * (photoHeight + photoGap);

          ctx.fillStyle = (currentBgTheme === 'white' || currentBgTheme === 'sepia') ? '#f1f5f9' : '#1e293b';
          ctx.fillRect(x, y, photoWidth, photoHeight);

          if (loadedImages[i]) {
            drawCoverImage(ctx, loadedImages[i], x, y, photoWidth, photoHeight);
          } else {
            ctx.fillStyle = (currentBgTheme === 'white' || currentBgTheme === 'sepia') ? '#94a3b8' : '#475569';
            ctx.font = 'bold 20px Outfit, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(`FRAME ${i + 1}`, x + photoWidth / 2, y + photoHeight / 2);
          }

          ctx.strokeStyle = 'rgba(0,0,0,0.25)';
          ctx.lineWidth = 4;
          ctx.strokeRect(x, y, photoWidth, photoHeight);
        }
      } else if (currentLayout === 'grid2x2') {
        const photoWidth = (w - (padding * 3)) / 2;
        const photoHeight = (availableHeight - padding) / 2;
        const slots = [
          { x: padding, y: headerSpace },
          { x: padding * 2 + photoWidth, y: headerSpace },
          { x: padding, y: headerSpace + photoHeight + padding },
          { x: padding * 2 + photoWidth, y: headerSpace + photoHeight + padding }
        ];

        slots.forEach((slot, i) => {
          ctx.fillStyle = (currentBgTheme === 'white' || currentBgTheme === 'sepia') ? '#f1f5f9' : '#1e293b';
          ctx.fillRect(slot.x, slot.y, photoWidth, photoHeight);

          if (loadedImages[i]) {
            drawCoverImage(ctx, loadedImages[i], slot.x, slot.y, photoWidth, photoHeight);
          } else {
            ctx.fillStyle = '#94a3b8';
            ctx.font = 'bold 18px Outfit, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(`FRAME ${i + 1}`, slot.x + photoWidth / 2, slot.y + photoHeight / 2);
          }
        });
      } else if (currentLayout === 'polaroid') {
        const photoWidth = w - (padding * 2);
        const photoHeight = photoWidth * 0.85;
        const x = padding;
        const y = headerSpace + 20;

        ctx.fillStyle = (currentBgTheme === 'white' || currentBgTheme === 'sepia') ? '#f1f5f9' : '#1e293b';
        ctx.fillRect(x, y, photoWidth, photoHeight);

        if (loadedImages[0]) {
          drawCoverImage(ctx, loadedImages[0], x, y, photoWidth, photoHeight);
        } else {
          ctx.fillStyle = '#94a3b8';
          ctx.font = 'bold 22px Outfit, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(`POLAROID SNAP`, x + photoWidth / 2, y + photoHeight / 2);
        }
      }

      const fontStyle = document.getElementById('fontSelect').value;
      const textColor = document.getElementById('textColorPicker').value;
      const headerText = document.getElementById('headerTextInput').value || '3FOLKS MEDIA';
      const captionText = document.getElementById('captionTextInput').value || '';
      const showLogo = document.getElementById('showLogoChk').checked;
      const showDate = document.getElementById('showDateChk').checked;

      ctx.textAlign = 'center';
      ctx.fillStyle = textColor;
      ctx.font = `bold 28px ${fontStyle}`;
      ctx.fillText(headerText, w / 2, 60);

      if (captionText) {
        ctx.font = `bold 16px ${fontStyle}`;
        ctx.fillStyle = textColor;
        ctx.globalAlpha = 0.85;
        ctx.fillText(captionText, w / 2, 90);
        ctx.globalAlpha = 1.0;
      }

      const logoY = h - 165;
      const dateY = h - 25;

      if (showLogo) {
        const whiteLogo = getWhiteLogoCanvas();
        if (whiteLogo) {
          const logoWidth = 140;
          const logoHeight = (whiteLogo.height / whiteLogo.width) * logoWidth;
          const logoX = (w - logoWidth) / 2;
          ctx.drawImage(whiteLogo, logoX, logoY, logoWidth, logoHeight);
        } else {
          ctx.font = '900 26px Outfit, sans-serif';
          ctx.textAlign = 'left';
          const text3 = '3';
          const textRest = 'FOLKS MEDIA';
          const width3 = ctx.measureText(text3).width;
          const widthRest = ctx.measureText(textRest).width;
          const startX = (w - (width3 + widthRest)) / 2;
          ctx.fillStyle = '#7c3aed';
          ctx.fillText(text3, startX, logoY + 24);
          ctx.fillStyle = (currentBgTheme === 'white' || currentBgTheme === 'sepia') ? '#0f172a' : '#ffffff';
          ctx.fillText(textRest, startX + width3, logoY + 24);
          ctx.textAlign = 'center';
        }
      }

      if (showDate) {
        const now = new Date();
        const dateStr = now.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }).toUpperCase();
        const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
        
        ctx.font = 'bold 12px Inter, sans-serif';
        ctx.fillStyle = textColor;
        ctx.globalAlpha = 0.75;
        ctx.fillText(`${dateStr} • ${timeStr} • STUDIO PHOTOBOOTH`, w / 2, dateY);
        ctx.globalAlpha = 1.0;
      }

      if (activeStickers.length > 0) {
        ctx.font = '36px sans-serif';
        activeStickers.forEach((stk, idx) => {
          const stkX = padding + (idx * 45);
          ctx.fillText(stk, stkX + 10, h - 40);
        });
      }
    }

    function drawCoverImage(ctx, img, x, y, width, height) {
      if (!img || !img.complete || img.naturalWidth === 0) return;
      const imgRatio = img.naturalWidth / img.naturalHeight;
      const targetRatio = width / height;

      let sw, sh, sx, sy;
      if (imgRatio > targetRatio) {
        sh = img.naturalHeight; sw = sh * targetRatio; sx = (img.naturalWidth - sw) / 2; sy = 0;
      } else {
        sw = img.naturalWidth; sh = sw / targetRatio; sx = 0; sy = (img.naturalHeight - sh) / 2;
      }
      ctx.drawImage(img, sx, sy, sw, sh, x, y, width, height);
    }

    async function downloadStrip(format = 'png') {
      const dataUrl = canvas.toDataURL(`image/${format}`, 1.0);
      const fileName = `3FolksMedia_PhotoStrip_${Date.now()}.${format}`;

      savedGalleryStrips.unshift({
        id: Date.now(),
        url: dataUrl,
        isFav: false,
        timestamp: new Date().toLocaleDateString('en-US', { month: 'short', day: '2-digit' })
      });
      renderGallery();

      const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || (navigator.maxTouchPoints && navigator.maxTouchPoints > 0);

      // Attempt Web Share API if supported on mobile
      if (isMobile && navigator.canShare && canvas.toBlob) {
        try {
          canvas.toBlob(async (blob) => {
            const file = new File([blob], fileName, { type: `image/${format}` });
            if (navigator.canShare({ files: [file] })) {
              await navigator.share({
                files: [file],
                title: '3FM Branded Photo Strip',
                text: 'Created with 3FolksMedia Photobooth Studio ✨'
              });
              return;
            } else {
              triggerMobileDownloadFallback(dataUrl, fileName);
            }
          }, `image/${format}`);
          return;
        } catch (err) {
          console.warn("Web Share failed, fallback to modal:", err);
        }
      }

      // Desktop or standard download
      try {
        const link = document.createElement('a');
        link.download = fileName;
        link.href = dataUrl;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      } catch (err) {
        triggerMobileDownloadFallback(dataUrl, fileName);
      }

      if (isMobile) {
        triggerMobileDownloadFallback(dataUrl, fileName);
      }
    }

    function triggerMobileDownloadFallback(dataUrl, fileName) {
      const modal = document.getElementById('mobileSaveModal');
      const imgElem = document.getElementById('mobileSaveImg');
      const dlBtn = document.getElementById('mobileSaveDlBtn');
      if (modal && imgElem) {
        imgElem.src = dataUrl;
        if (dlBtn) {
          dlBtn.href = dataUrl;
          dlBtn.download = fileName;
        }
        modal.classList.add('active');
      }
    }

    async function copyCanvasToClipboard() {
      try {
        canvas.toBlob(async (blob) => {
          await navigator.clipboard.write([ new ClipboardItem({ 'image/png': blob }) ]);
          alert("✅ Branded Photo Strip copied to clipboard!");
        });
      } catch (err) {
        alert("Failed to copy image to clipboard automatically. Try downloading PNG instead!");
      }
    }

    function printStrip() {
      const dataUrl = canvas.toDataURL('image/png');
      const win = window.open('');
      win.document.write(`
        <html>
          <head><title>Print 3FolksMedia Photo Strip</title></head>
          <body style="margin:0; display:flex; justify-content:center; align-items:center; height:100vh; background:#f8fafc;">
            <img src="${dataUrl}" style="max-height:95vh; box-shadow: 0 10px 30px rgba(0,0,0,0.15);" onload="window.print();window.close();"/>
          </body>
        </html>
      `);
      win.document.close();
    }

    function renderGallery(filter = 'all') {
      const grid = document.getElementById('galleryGrid');
      let items = savedGalleryStrips;
      if (filter === 'favorites') items = items.filter(item => item.isFav);

      if (items.length === 0) {
        grid.innerHTML = `<div style="grid-column: 1 / -1; font-size: 13px; color: #94a3b8; padding: 20px 0; text-align: center; font-weight: 600;">
          No saved photo strips yet. Download a photo strip to save it in your studio gallery archives!
        </div>`;
        return;
      }

      grid.innerHTML = items.map((item) => `
        <div class="gallery-item-card">
          <img src="${item.url}" class="gallery-item-img" />
          <button class="fav-btn ${item.isFav ? 'active' : ''}" onclick="toggleFav(${item.id})" title="Favorite">
            ${item.isFav ? '❤️' : '🤍'}
          </button>
        </div>
      `).join('');
    }

    function toggleFav(id) {
      const item = savedGalleryStrips.find(s => s.id === id);
      if (item) { item.isFav = !item.isFav; renderGallery(); }
    }

    function filterGallery(type, btnElem) {
      const parent = btnElem.parentElement;
      parent.querySelectorAll('.light-pill').forEach(b => b.classList.remove('active'));
      btnElem.classList.add('active');
      renderGallery(type);
    }

    // ================= 2. 🚀 3FM JETPACK SPACE RUNNER GAME ENGINE =================
    let runnerCanvas, runnerCtx;
    let runnerGameRunning = false;
    let playerY = 260, playerVelocity = 0, gravity = 0.28, lift = -5.8;
    let coins = [], obstacles = [], particles = [], runnerScore = 0, runnerHighScore = localStorage.getItem('3fm_runner_highscore') || 0;
    let runnerAnimationId;

    document.getElementById('runnerHighScore').innerText = runnerHighScore;

    function initRunnerGame() {
      runnerCanvas = document.getElementById('runnerCanvas');
      runnerCtx = runnerCanvas.getContext('2d');
      resizeRunnerCanvas();
    }

    function resizeRunnerCanvas() {
      const card = document.getElementById('runnerViewportCard');
      if (card && runnerCanvas) {
        runnerCanvas.width = card.clientWidth || 1100;
        runnerCanvas.height = card.clientHeight || 540;
      }
    }

    function startRunnerGame() {
      document.getElementById('runnerOverlay').style.display = 'none';
      resizeRunnerCanvas();
      runnerGameRunning = true;
      playerY = runnerCanvas.height / 2;
      playerVelocity = 0;
      runnerScore = 0; coins = []; obstacles = []; particles = [];
      gameLoop();
    }

    function gameLoop() {
      if (!runnerGameRunning) return;
      const w = runnerCanvas.width, h = runnerCanvas.height;
      runnerCtx.clearRect(0, 0, w, h);

      // Deep Space Parallax Background
      runnerCtx.fillStyle = '#090d16';
      runnerCtx.fillRect(0, 0, w, h);

      // Cosmic Radial Glow Nebulas
      const nebGrad1 = runnerCtx.createRadialGradient(w * 0.2, h * 0.3, 20, w * 0.2, h * 0.3, 280);
      nebGrad1.addColorStop(0, 'rgba(124, 58, 237, 0.15)'); nebGrad1.addColorStop(1, 'transparent');
      runnerCtx.fillStyle = nebGrad1; runnerCtx.fillRect(0, 0, w, h);

      const nebGrad2 = runnerCtx.createRadialGradient(w * 0.8, h * 0.7, 20, w * 0.8, h * 0.7, 300);
      nebGrad2.addColorStop(0, 'rgba(2, 132, 199, 0.12)'); nebGrad2.addColorStop(1, 'transparent');
      runnerCtx.fillStyle = nebGrad2; runnerCtx.fillRect(0, 0, w, h);

      // Parallax Starfield (3 Layers)
      const nowTime = Date.now();
      for (let layer = 1; layer <= 3; layer++) {
        const speed = layer * 0.8;
        const starSize = layer * 1.2;
        runnerCtx.fillStyle = layer === 3 ? '#ffffff' : (layer === 2 ? '#c084fc' : '#38bdf8');
        
        for (let i = 0; i < 25; i++) {
          const sx = (w + ((nowTime * speed * 0.05 + i * 90) % w)) % w;
          const sy = (i * 37 + layer * 40) % h;
          runnerCtx.fillRect(w - sx, sy, starSize, starSize);
        }
      }

      // Physics
      playerVelocity += gravity;
      playerY += playerVelocity;

      if (playerY < 30) { playerY = 30; playerVelocity = 0; }
      if (playerY > h - 30) { gameOverRunner(); return; }

      // Spawn Jetpack Thruster Flame Particles
      particles.push({
        x: 100 + Math.random() * 4,
        y: playerY + 12 + Math.random() * 6,
        vx: -3.5 - Math.random() * 2,
        vy: (Math.random() - 0.5) * 1.5,
        life: 1.0,
        color: Math.random() > 0.4 ? '#38bdf8' : '#7c3aed'
      });

      // Move & Draw Thruster Particles
      particles.forEach((p, idx) => {
        p.x += p.vx;
        p.y += p.vy;
        p.life -= 0.06;
        if (p.life > 0) {
          runnerCtx.fillStyle = p.color;
          runnerCtx.globalAlpha = p.life;
          runnerCtx.beginPath();
          runnerCtx.arc(p.x, p.y, 4 * p.life, 0, Math.PI * 2);
          runnerCtx.fill();
        }
      });
      runnerCtx.globalAlpha = 1.0;
      particles = particles.filter(p => p.life > 0);

      // Draw 3FM Jetpack Astronaut
      // Jetpack Body
      runnerCtx.fillStyle = '#475569';
      runnerCtx.beginPath(); runnerCtx.roundRect(96, playerY - 14, 14, 28, 4); runnerCtx.fill();

      // Astronaut Helmet & Body
      runnerCtx.fillStyle = '#ffffff';
      runnerCtx.beginPath(); runnerCtx.arc(120, playerY - 4, 18, 0, Math.PI * 2); runnerCtx.fill();
      runnerCtx.beginPath(); runnerCtx.roundRect(110, playerY + 8, 22, 18, 6); runnerCtx.fill();

      // Glowing Helmet Visor
      const visorGrad = runnerCtx.createLinearGradient(120, playerY - 10, 134, playerY + 2);
      visorGrad.addColorStop(0, '#7c3aed'); visorGrad.addColorStop(1, '#0284c7');
      runnerCtx.fillStyle = visorGrad;
      runnerCtx.beginPath(); runnerCtx.arc(124, playerY - 4, 10, 0, Math.PI * 2); runnerCtx.fill();
      
      runnerCtx.fillStyle = '#ffffff';
      runnerCtx.beginPath(); runnerCtx.arc(127, playerY - 7, 3, 0, Math.PI * 2); runnerCtx.fill();

      // Spawn Obstacles (Neon Laser Pillars & Asteroids)
      if (Math.random() < 0.013 && (obstacles.length === 0 || obstacles[obstacles.length - 1].x < w - 260)) {
        const obH = 70 + Math.random() * 110;
        const isTop = Math.random() > 0.5;
        obstacles.push({
          x: w,
          y: isTop ? 0 : h - obH,
          w: 34,
          h: obH,
          color: isTop ? '#ef4444' : '#a855f7'
        });
      }

      // Spawn Shiny 3FM Golden Coins
      if (Math.random() < 0.024 && (coins.length === 0 || coins[coins.length - 1].x < w - 180)) {
        coins.push({
          x: w,
          y: 60 + Math.random() * (h - 120),
          r: 14,
          spin: 0
        });
      }

      // Move & Draw Obstacles
      obstacles.forEach((ob) => {
        ob.x -= 2.8;

        // Glowing Laser Pillar Effect
        runnerCtx.save();
        runnerCtx.shadowBlur = 16;
        runnerCtx.shadowColor = ob.color;
        runnerCtx.fillStyle = ob.color;
        runnerCtx.fillRect(ob.x, ob.y, ob.w, ob.h);

        // Inner Core Beam
        runnerCtx.fillStyle = '#ffffff';
        runnerCtx.fillRect(ob.x + 8, ob.y, ob.w - 16, ob.h);
        runnerCtx.restore();

        // Collision Check
        if (ob.x < 138 && ob.x + ob.w > 102) {
          if (playerY - 18 < ob.y + ob.h && playerY + 18 > ob.y) {
            gameOverRunner();
          }
        }
      });
      obstacles = obstacles.filter(ob => ob.x > -50);

      // Move & Draw Shiny Coins
      coins.forEach((c) => {
        c.x -= 2.8;
        c.spin += 0.1;

        runnerCtx.save();
        runnerCtx.shadowBlur = 12;
        runnerCtx.shadowColor = '#f59e0b';

        // Outer Gold Ring
        runnerCtx.fillStyle = '#f59e0b';
        runnerCtx.beginPath();
        runnerCtx.arc(c.x, c.y, c.r, 0, Math.PI * 2);
        runnerCtx.fill();

        // Inner Shiny Core
        runnerCtx.fillStyle = '#fef08a';
        runnerCtx.beginPath();
        runnerCtx.arc(c.x, c.y, c.r - 4, 0, Math.PI * 2);
        runnerCtx.fill();

        // 3FM Insignia Text
        runnerCtx.fillStyle = '#78350f';
        runnerCtx.font = '900 11px Outfit, sans-serif';
        runnerCtx.textAlign = 'center';
        runnerCtx.fillText('3FM', c.x, c.y + 4);
        runnerCtx.restore();

        // Collect Coin Check
        const dist = Math.hypot(120 - c.x, playerY - c.y);
        if (dist < 32) {
          runnerScore += 10;
          playBeep();
          c.collected = true;
        }
      });
      coins = coins.filter(c => !c.collected && c.x > -30);

      // Score Display HUD
      runnerCtx.fillStyle = '#ffffff';
      runnerCtx.font = '900 22px Outfit, sans-serif';
      runnerCtx.fillText(`SCORE: ${runnerScore}  HI: ${runnerHighScore}`, 30, 45);

      runnerAnimationId = requestAnimationFrame(gameLoop);
    }

    function gameOverRunner() {
      runnerGameRunning = false;
      cancelAnimationFrame(runnerAnimationId);

      if (runnerScore > runnerHighScore) {
        runnerHighScore = runnerScore;
        localStorage.setItem('3fm_runner_highscore', runnerHighScore);
        document.getElementById('runnerHighScore').innerText = runnerHighScore;
      }

      const overlay = document.getElementById('runnerOverlay');
      overlay.innerHTML = `
        <h2 style="font-size: 34px; font-weight: 900; color: #ef4444; margin-bottom: 8px;">💥 MISSION FAILED!</h2>
        <p style="font-size: 20px; font-weight: 800; color: #ffffff; margin-bottom: 24px;">SCORE: ${runnerScore} PTS</p>
        <button class="btn btn-3d-nav" onclick="startRunnerGame()" style="background: #7c3aed; color: white; border: none; font-size: 16px; padding: 14px 36px; font-weight: 900; border-radius: 30px; box-shadow: 0 10px 30px rgba(124, 58, 237, 0.4);">
          ⚡ PLAY AGAIN
        </button>
      `;
      overlay.style.display = 'flex';
    }

    // ================= 3. 🦖 3FM CHROME DINO JUMP RUNNER GAME ENGINE =================
    let dinoCanvas, dinoCtx;
    let dinoGameRunning = false;
    let dinoY = 460, dinoVelocity = 0, dinoGravity = 0.65, dinoJump = -13.0;
    let isDucking = false;
    let dinoCacti = [], dinoBirds = [], dinoClouds = [];
    let dinoScore = 0, dinoHighScore = localStorage.getItem('3fm_dino_highscore') || 0;
    let dinoAnimationId;

    document.getElementById('dinoHighScore').innerText = dinoHighScore;

    function initDinoGame() {
      dinoCanvas = document.getElementById('dinoCanvas');
      dinoCtx = dinoCanvas.getContext('2d');
      resizeDinoCanvas();
    }

    function resizeDinoCanvas() {
      const card = document.getElementById('dinoViewportCard');
      if (card && dinoCanvas) {
        dinoCanvas.width = card.clientWidth || 1100;
        dinoCanvas.height = card.clientHeight || 540;
      }
    }

    function startDinoGame() {
      document.getElementById('dinoOverlay').style.display = 'none';
      resizeDinoCanvas();
      dinoGameRunning = true;
      dinoY = dinoCanvas.height - 50; 
      dinoVelocity = 0; 
      isDucking = false;
      dinoScore = 0; dinoCacti = []; dinoBirds = []; dinoClouds = [];
      dinoLoop();
    }

    function dinoLoop() {
      if (!dinoGameRunning) return;
      const w = dinoCanvas.width, h = dinoCanvas.height;
      dinoCtx.clearRect(0, 0, w, h);

      dinoScore++;
      if (dinoScore % 100 === 0) playBeep();

      const isNight = Math.floor(dinoScore / 500) % 2 === 1;

      // Background Sky - Fills 100% of height!
      dinoCtx.fillStyle = isNight ? '#0f172a' : '#f8fafc';
      dinoCtx.fillRect(0, 0, w, h);

      // Sun or Moon
      dinoCtx.fillStyle = isNight ? '#f1f5f9' : '#fef08a';
      dinoCtx.beginPath();
      dinoCtx.arc(w - 100, 70, isNight ? 22 : 30, 0, Math.PI * 2);
      dinoCtx.fill();

      // Desert Ground Line
      const groundLineY = h - 50;
      dinoCtx.strokeStyle = isNight ? '#475569' : '#94a3b8';
      dinoCtx.lineWidth = 4;
      dinoCtx.beginPath();
      dinoCtx.moveTo(0, groundLineY);
      dinoCtx.lineTo(w, groundLineY);
      dinoCtx.stroke();

      // Physics
      dinoVelocity += dinoGravity;
      dinoY += dinoVelocity;

      const restingY = isDucking ? groundLineY - 14 : groundLineY;
      if (dinoY > restingY) {
        dinoY = restingY;
        dinoVelocity = 0;
      }

      // Draw Dino (T-Rex)
      dinoCtx.fillStyle = isNight ? '#38bdf8' : '#7c3aed';
      const dinoHeight = isDucking ? 28 : 46;
      const dinoWidth = isDucking ? 52 : 38;
      const drawY = dinoY - dinoHeight;

      // Dino Body
      dinoCtx.beginPath();
      dinoCtx.roundRect(100, drawY, dinoWidth, dinoHeight, 6);
      dinoCtx.fill();

      // Dino Eye
      dinoCtx.fillStyle = '#ffffff';
      dinoCtx.beginPath();
      dinoCtx.arc(100 + (isDucking ? 40 : 26), drawY + 10, 4.5, 0, Math.PI * 2);
      dinoCtx.fill();

      // Dino Legs Running Animation
      dinoCtx.strokeStyle = isNight ? '#38bdf8' : '#7c3aed';
      dinoCtx.lineWidth = 4;
      const legOffset = (Math.floor(Date.now() / 100) % 2 === 0) ? 7 : -7;
      dinoCtx.beginPath();
      dinoCtx.moveTo(110, dinoY); dinoCtx.lineTo(110 + legOffset, dinoY + 14);
      dinoCtx.moveTo(126, dinoY); dinoCtx.lineTo(126 - legOffset, dinoY + 14);
      dinoCtx.stroke();

      // Spawn Cacti
      if (Math.random() < 0.014 && (dinoCacti.length === 0 || dinoCacti[dinoCacti.length - 1].x < w - 240)) {
        const cHeight = 40 + Math.random() * 30;
        dinoCacti.push({ x: w, w: 26, h: cHeight });
      }

      // Spawn Flying Birds (Score > 200)
      if (dinoScore > 200 && Math.random() < 0.008 && (dinoBirds.length === 0 || dinoBirds[dinoBirds.length - 1].x < w - 300)) {
        dinoBirds.push({ x: w, y: groundLineY - 80 - Math.random() * 40, w: 34, h: 22 });
      }

      // Move & Draw Cacti
      dinoCtx.fillStyle = '#10b981';
      dinoCacti.forEach((cactus) => {
        cactus.x -= 5.8 + (dinoScore * 0.002);
        const cY = groundLineY - cactus.h;

        dinoCtx.fillRect(cactus.x, cY, cactus.w, cactus.h);

        // Collision Check
        if (cactus.x < 100 + dinoWidth && cactus.x + cactus.w > 100) {
          if (dinoY > cY) {
            gameOverDino();
          }
        }
      });
      dinoCacti = dinoCacti.filter(c => c.x > -40);

      // Move & Draw Birds
      dinoBirds.forEach((bird) => {
        bird.x -= 6.8 + (dinoScore * 0.002);
        dinoCtx.fillStyle = '#ef4444';
        dinoCtx.beginPath();
        dinoCtx.ellipse(bird.x, bird.y, bird.w / 2, bird.h / 2, 0, 0, Math.PI * 2);
        dinoCtx.fill();

        // Bird Wings Animation
        const wingY = (Math.floor(Date.now() / 150) % 2 === 0) ? -12 : 12;
        dinoCtx.beginPath();
        dinoCtx.moveTo(bird.x, bird.y);
        dinoCtx.lineTo(bird.x - 10, bird.y + wingY);
        dinoCtx.strokeStyle = '#ef4444';
        dinoCtx.lineWidth = 3.5;
        dinoCtx.stroke();

        // Collision Check
        if (bird.x - 16 < 100 + dinoWidth && bird.x + 16 > 100) {
          if (drawY < bird.y + 12 && dinoY > bird.y - 12) {
            gameOverDino();
          }
        }
      });
      dinoBirds = dinoBirds.filter(b => b.x > -40);

      // Score Display
      dinoCtx.fillStyle = isNight ? '#ffffff' : '#0f172a';
      dinoCtx.font = 'bold 22px Outfit, sans-serif';
      dinoCtx.fillText(`SCORE: ${dinoScore}  HI: ${dinoHighScore}`, 30, 45);

      dinoAnimationId = requestAnimationFrame(dinoLoop);
    }

    function gameOverDino() {
      dinoGameRunning = false;
      cancelAnimationFrame(dinoAnimationId);

      if (dinoScore > dinoHighScore) {
        dinoHighScore = dinoScore;
        localStorage.setItem('3fm_dino_highscore', dinoHighScore);
        document.getElementById('dinoHighScore').innerText = dinoHighScore;
      }

      const overlay = document.getElementById('dinoOverlay');
      overlay.innerHTML = `
        <h2 style="font-size: 32px; font-weight: 900; color: #ef4444; margin-bottom: 8px;">💥 GAME OVER!</h2>
        <p style="font-size: 20px; font-weight: 800; color: #ffffff; margin-bottom: 20px;">SCORE: ${dinoScore} PTS</p>
        <button class="btn btn-3d-nav" onclick="startDinoGame()" style="background: #7c3aed; color: white; border: none; font-size: 16px; padding: 14px 32px; font-weight: 800;">
          ⚡ PLAY AGAIN
        </button>
      `;
      overlay.style.display = 'flex';
    }

    // KEYBOARD HANDLERS
    document.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;

      if (currentSelectedTarget === 'photobooth') {
        if (e.code === 'Space') { e.preventDefault(); captureSinglePhoto(); }
        else if (e.code === 'KeyR') resetPhotos();
        else if (e.code === 'KeyD') downloadStrip('png');
      } else if (currentSelectedTarget === 'space-runner') {
        if (e.code === 'Space' || e.code === 'ArrowUp') {
          e.preventDefault();
          if (runnerGameRunning) playerVelocity = lift;
        }
      } else if (currentSelectedTarget === 'dino-jump') {
        if (e.code === 'Space' || e.code === 'ArrowUp') {
          e.preventDefault();
          if (dinoGameRunning && dinoY >= (dinoCanvas ? dinoCanvas.height - 70 : 300)) dinoVelocity = dinoJump;
        } else if (e.code === 'ArrowDown') {
          e.preventDefault();
          if (dinoGameRunning) isDucking = true;
        }
      }
    });

    document.addEventListener('keyup', (e) => {
      if (currentSelectedTarget === 'dino-jump' && e.code === 'ArrowDown') {
        isDucking = false;
      }
    });

    window.addEventListener('resize', () => {
      if (currentSelectedTarget === 'dino-jump') resizeDinoCanvas();
      if (currentSelectedTarget === 'space-runner') resizeRunnerCanvas();
    });

    function setupMobileTouchEvents() {
      const runnerCard = document.getElementById('runnerViewportCard');
      const runnerTouchBtn = document.getElementById('spaceRunnerTouchBtn');

      function triggerRunnerFlight(e) {
        if (e && e.cancelable && e.target.tagName !== 'BUTTON') e.preventDefault();
        if (currentSelectedTarget !== 'space-runner') return;
        if (!runnerGameRunning) {
          startRunnerGame();
        } else {
          playerVelocity = lift;
        }
      }

      if (runnerCard) {
        runnerCard.addEventListener('touchstart', triggerRunnerFlight, { passive: false });
        runnerCard.addEventListener('mousedown', triggerRunnerFlight);
      }
      if (runnerTouchBtn) {
        runnerTouchBtn.addEventListener('touchstart', triggerRunnerFlight, { passive: false });
        runnerTouchBtn.addEventListener('mousedown', triggerRunnerFlight);
      }

      const dinoCard = document.getElementById('dinoViewportCard');
      const dinoJumpBtn = document.getElementById('dinoJumpTouchBtn');
      const dinoDuckBtn = document.getElementById('dinoDuckTouchBtn');

      function triggerDinoJump(e) {
        if (e && e.cancelable && e.target.tagName !== 'BUTTON') e.preventDefault();
        if (currentSelectedTarget !== 'dino-jump') return;
        if (!dinoGameRunning) {
          startDinoGame();
        } else {
          const groundLineY = (dinoCanvas ? dinoCanvas.height - 70 : 450);
          if (dinoY >= groundLineY) dinoVelocity = dinoJump;
        }
      }

      function triggerDinoDuckStart(e) {
        if (e && e.cancelable) e.preventDefault();
        if (dinoGameRunning) isDucking = true;
      }

      function triggerDinoDuckEnd(e) {
        if (e && e.cancelable) e.preventDefault();
        isDucking = false;
      }

      if (dinoCard) {
        dinoCard.addEventListener('touchstart', triggerDinoJump, { passive: false });
        dinoCard.addEventListener('mousedown', triggerDinoJump);
      }
      if (dinoJumpBtn) {
        dinoJumpBtn.addEventListener('touchstart', triggerDinoJump, { passive: false });
        dinoJumpBtn.addEventListener('mousedown', triggerDinoJump);
      }
      if (dinoDuckBtn) {
        dinoDuckBtn.addEventListener('touchstart', triggerDinoDuckStart, { passive: false });
        dinoDuckBtn.addEventListener('touchend', triggerDinoDuckEnd);
        dinoDuckBtn.addEventListener('mousedown', triggerDinoDuckStart);
        dinoDuckBtn.addEventListener('mouseup', triggerDinoDuckEnd);
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      showGamesHub();
      setupMobileTouchEvents();
    });
  </script>
</body>

</html>
