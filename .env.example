# ==========================================
# 3FOLKS MEDIA / CREATOR PORTAL - ENVIRONMENT VARIABLES SAMPLE
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Security & Session
SESSION_SECRET="your-secret-session-key-change-in-production"

# Database Configuration
# PostgreSQL connection string for Render:
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Email Settings (Brevo / Resend / Gmail SMTP)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@3fm.co"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM_NAME="Team 3Folks Media"

# AWS S3 Storage
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION="ap-south-1"
